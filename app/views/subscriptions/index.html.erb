   <% if @show_payment_modal %>
  
  <%if session[:souscription_amount]
    @current_souscription_amount = session[:souscription_amount]
    # converted_amount contient maintenant votre valeur en XOF
  end%>
  <div class="payment-modal-overlay" style="display: flex;">
    <div class="payment-modal-container">
      <div class="text-center">
        <!-- Loader et message -->
        <div id="payment-loader" style="display: block;">
          <div class="spinner mb-3"></div>
          <p id="loader-message">Chargement du widget de paiement...</p>
        </div>

        <!-- Widget FedaPay -->
        <div id="embed" style="display: none; width: 100%; height: 420px"></div>

        <!-- Formulaire caché pour soumettre l'ID -->
        <%= form_tag process_payment_subscription_path(@subscription), method: :post, id: 'payment-form', class: 'w-100' do %>
          <%= hidden_field_tag 'amount', @current_souscription_amount.to_i %>
          <%= hidden_field_tag 'id', @subscription.id %>
          <%= hidden_field_tag 'transaction-id', '', id: 'transaction-id' %>
        <% end %>
      </div>
    </div>
  </div>

  <style>
    .payment-modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.6);
      z-index: 9999;
      justify-content: center;
      align-items: center;
    }

    .payment-modal-container {
      background: white;
      border-radius: 8px;
      padding: 2rem;
      width: 90%;
      max-width: 500px;
      text-align: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
    }

    .spinner {
      width: 40px;
      height: 40px;
      margin: 0 auto;
      border: 5px solid #e2e8f0;
      border-top: 5px solid #0d6efd;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>

  <script type="text/javascript">
    // Simule un petit délai pour montrer le loader avant le chargement du widget
    setTimeout(() => {
      FedaPay.init({
        public_key: 'pk_sandbox_ywrlaTQdbqll7iBWVEkbrCZe',
        transaction: {
          amount: <%= @current_souscription_amount.to_i %>,
          description: "Souscription <%= @subscription.id %>"
        },
        customer: {
          email: '<%= current_user.email %>',
          firstname: '<%= current_user.prenom %>',
          lastname: '<%= current_user.nom %>'
        },
         // Paiement réussi
        onComplete: function (response) {
          console.log(response);
          if (response && response.transaction && response.transaction.status === 'approved') {
            document.getElementById('embed').style.display = 'none';
             document.getElementById('payment-loader').style.display = 'block';
            document.getElementById('loader-message').innerText = "Paiement reçu. Traitement en cours...";
            document.getElementById('loader-message').style.color = "green";

            const transactionId = response.transaction.id;
            document.getElementById('transaction-id').value = transactionId;
            console.log("Transaction ID :", transactionId);

            // Attendre une micro pause pour soumettre correctement
            setTimeout(() => {
              console.log("Soumission du formulaire");
              document.getElementById('payment-form').submit();
            }, 100);
          } else {
             document.getElementById('embed').style.display = 'none';
             document.getElementById('payment-loader').style.display = 'block';
            document.getElementById('loader-message').innerText = "Paiement annulé ou refusé.";
            document.getElementById('loader-message').style.color = "red";
            setTimeout(() => {
              // Ferme le modal (tu peux le cacher ou le supprimer)
              const modal = document.querySelector('.payment-modal-overlay');
              if (modal) modal.remove();

              // Redirige vers une page sécurisée
              window.location.href = "<%= souscriptions_path %>"; // Ou autre route
            }, 2000);
          }
        },

        // Paiement annulé sans retour (fermeture manuelle du widget)
        onClose: function () {
          document.getElementById('loader-message').innerText = "Paiement annulé.";
          setTimeout(() => {
        // Ferme le modal (tu peux le cacher ou le supprimer)
        const modal = document.querySelector('.payment-modal-overlay');
        if (modal) modal.remove();

        // Redirige vers une page sécurisée
        window.location.href = "<%= souscriptions_path %>"; // Ou autre route
      }, 2000);;
        },
        onError: function () {
          document.getElementById('loader-message').innerText = "Erreur de chargement du widget. Veuillez réessayer.";
          document.getElementById('embed').style.display = 'none';
          document.getElementById('payment-loader').style.display = 'block';
        },
        container: '#embed'
      });

      // Affiche le widget, masque le loader
      document.getElementById('payment-loader').style.display = 'none';
      document.getElementById('embed').style.display = 'block';
    }, 1200);
  </script>

<% end %>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Copier le code de parrainage
            $('#copyBtn').click(function() {
                const code = $('#referralCode').text();
                navigator.clipboard.writeText(code)
                    .then(() => {
                        $(this).html('<i class="fas fa-check"></i>');
                        $(this).addClass('btn-success').removeClass('btn-light');
                        setTimeout(() => {
                            $(this).html('<i class="fas fa-copy"></i>');
                            $(this).addClass('btn-light').removeClass('btn-success');
                        }, 2000);
                    });
            });
            
            // Soumission du formulaire de paiement
            $('#paymentForm').submit(function(e) {
                e.preventDefault();
                
                const btn = $(this).find('button[type="submit"]');
                btn.html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Traitement...');
                
                // Simulation de traitement de paiement
                setTimeout(() => {
                    // Animation de succès
                    $('.premium-header').css('background', 'linear-gradient(135deg, #20bf6b 0%, #01baef 100%)');
                    $('.premium-badge').css('background', 'linear-gradient(135deg, #20bf6b 0%, #01baef 100%)');
                    $('.premium-badge').html('<i class="fas fa-check me-2"></i>ABONNEMENT ACTIVÉ');
                    
                    // Message de succès
                    const successHTML = `
                        <div class="text-center py-5">
                            <i class="fas fa-check-circle display-1 text-success mb-4"></i>
                            <h2 class="fw-bold mb-3">Votre compte premium est activé !</h2>
                            <p class="lead mb-4">Félicitations ! Vous avez maintenant accès à toutes les fonctionnalités premium.</p>
                            <a href="dashboard.html" class="btn btn-primary btn-lg px-5">
                                <i class="fas fa-tachometer-alt me-2"></i>Accéder à votre tableau de bord
                            </a>
                        </div>
                    `;
                    
                    $('.premium-content').html(successHTML);
                }, 2000);
            });
        });
    </script>
    <% if @show_payment_modal %>
    <script>
        document.addEventListener("turbo:load", function () {
        const modal = new bootstrap.Modal(document.getElementById("premiumModal"));
        modal.show();
        });
    </script>
    <% end %>
