  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

  <style>
    :root{--usa-blue:#002868;--usa-red:#bf0a30;--usa-gold:#ffb703;--dark:#02040a;}
    body{font-family:'Roboto',sans-serif;background:#fff;color:#111;overflow-x:hidden}
    h1,h2,h3{font-family:'Oswald',sans-serif;text-transform:uppercase;letter-spacing:.5px}
    .navbar{background:#ffffffee!important;backdrop-filter:blur(8px);box-shadow:0 2px 8px #00000010}
    .btn-usa{background:linear-gradient(90deg,var(--usa-red),var(--usa-gold));color:#fff;font-weight:700;padding:.7rem 2rem;border-radius:3px;transition:.3s}
    .btn-usa:hover{filter:brightness(1.15);color:#fff}
    .text-gradient{background:linear-gradient(90deg,var(--usa-blue),var(--usa-gold));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
    .hero-video{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:-1}
    .hero-overlay{background:linear-gradient(90deg,rgba(0,40,104,.7),rgba(191,10,48,.6));position:absolute;top:0;left:0;width:100%;height:100%;z-index:-1}
    .min-vh-90{min-height:90vh}
    .card-usa{border:none;border-left:5px solid var(--usa-gold);background:#f8f9fa}
    #particles-js{position:absolute;width:100%;height:100%;top:0;left:0;z-index:-2}
    .table-gold th{background:var(--usa-gold);color:#000}
  </style>

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light fixed-top">

  <div class="container">
    <a class="navbar-brand fw-bold text-gradient" href="/"> <%= image_tag 'logo2.png', style: 'width: 50px;' %></a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#nv"
      aria-controls="nv"
      aria-expanded="false"
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="nv">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="#plans">Contrats pétrole</a></li>
        <li class="nav-item"><a class="nav-link" href="#parrainage">Parrainage</a></li>
        <li class="nav-item"><a class="nav-link" href="#faq">FAQ</a></li>
        <li class="nav-item ms-lg-3"><a class="btn btn-usa" href="<%=login_path%>">Connexion</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- HERO VIDEO -->
<section class="min-vh-90 d-flex align-items-center position-relative text-white">
  <div id="particles-js"></div>
 <video class="hero-video" autoplay muted loop playsinline>
  <source src="<%= asset_path('usa-oil.mp4') %>" type="video/mp4">
</video>
  <div class="hero-overlay"></div>
  <div class="container text-center" data-aos="fade-up">
    <h1 class="display-3 fw-bold mb-3">Achetez du <span class="text-gradient">pétrole américain</span>, percevez un revenu <strong>tous les jours</strong></h1>
    <p class="lead mb-4">Un seul achat. Au moins 30 jours de revenus garantis. Versement automatique <u>chaque 24 h</u> sur votre compte.</p>
    <a class="btn btn-usa btn-lg px-5 py-3" href="#plans">Démarre maintenant</a>
  </div>
</section>

<!-- PLANS PETROLE -->
<section id="plans" class="py-5">
  <div class="container">
    <h2 class="text-center mb-5" data-aos="fade-up">Choisissez votre <span class="text-gradient">contrat pétrolier</span></h2>
    <div class="table-responsive">
      <% if @products.any? %>
      <table class="table table-hover text-center align-middle table-gold">
        <thead><tr><th>Achat</th><th>Revenus/jour (Fcfa)</th><th>Gain total (Fcfa)</th><th>Contrat</th></tr></thead>
        <tbody>
          <% @products.each do |product| %>
          <tr><td> <strong><%= product.name %> </strong> <span class="text-muted"><%= product.purchase_price%> FCFA</span></td><td><%= product.daily_revenue%></td><td><%= product.total_gain%></td><td><%= product.contract_days %> jours</td></tr>
          <%end%>
        </tbody>
      </table>
      <%else%>
        <div class="alert alert-light text-center py-5">
          <i class="bi bi-emoji-neutral fs-1 text-muted"></i>
          <p class="mt-3 mb-0 text-muted">
            Aucun contrat d'investissment disponible pour le moment
          </p>
        </div>
      <%end%>
    </div>
    <p class="text-center mt-3"><small>Aucun frais caché – TVA comprise – retrait sous 24 h.</small></p>
  </div>
</section>

<!-- PARRAINAGE -->
<section id="parrainage" class="py-5 bg-light">
  <div class="container text-center">
    <h2 class="mb-4" data-aos="fade-up">Parrainage – <span class="text-gradient"><%= @prime%> % one-shot</span></h2>
    <div class="row gx-4 justify-content-center">
      <div class="col-md-5" data-aos="flip-left"><div class="card-usa p-4"><h5 class="text-gradient">10 filleuls</h5><div class="fs-4">25 000 F</div><small>bonus immédiat</small></div></div>
      <div class="col-md-5" data-aos="flip-right"><div class="card-usa p-4"><h5 class="text-gradient">30 filleuls</h5><div class="fs-4">100 000 F</div><small>bonus immédiat</small></div></div>
    </div>
    <p class="mt-4 mb-0">Exemple : parrainez un ami qui achète 18 000 F → vous touchez <strong>900 F</strong> instantanément.</p>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="py-5">
  <div class="container">
    <h2 class="text-center mb-5" data-aos="fade-up">FAQ</h2>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="accordion accordion-flush" id="faqAcc">
          <div class="accordion-item"><h6 class="accordion-header"><button class="accordion-button collapsed fw-bold" data-bs-toggle="collapse" data-bs-target="#q1">Mon capital est-il à risque ?</button></h6><div id="q1" class="accordion-collapse collapse" data-bs-parent="#faqAcc"><div class="accordion-body">Oui. Les prix du pétrole fluctuent. Nous limitons le risque en diversifiant les puits et en couvrant les positions, mais n’investissez jamais plus que ce que vous pouvez vous permettre de perdre.</div></div></div>
          <div class="accordion-item"><h6 class="accordion-header"><button class="accordion-button collapsed fw-bold" data-bs-toggle="collapse" data-bs-target="#q2">Comment verser un nouvel achat ?</button></h6><div id="q2" class="accordion-collapse collapse" data-bs-parent="#faqAcc"><div class="accordion-body">Carte bancaire, Orange-Money, MTN, Moov, Wave, crypto USDT. Le montant apparaît instantanément dans votre portefeuille pétrole.</div></div></div>
          <div class="accordion-item"><h6 class="accordion-header"><button class="accordion-button collapsed fw-bold" data-bs-toggle="collapse" data-bs-target="#q3">Puis-je retirer avant 75 jours ?</button></h6><div id="q3" class="accordion-collapse collapse" data-bs-parent="#faqAcc"><div class="accordion-body">Les gains quotidiens sont disponibles dès 24 h. Le capital reste actif 75 jours ; vous pouvez toutefois le sortir anticipément avec une pénalité de 10 %.</div></div></div>
          <div class="accordion-item"><h6 class="accordion-header"><button class="accordion-button collapsed fw-bold" data-bs-toggle="collapse" data-bs-target="#q4">Le parrainage est-il obligatoire ?</button></h6><div id="q4" class="accordion-collapse collapse" data-bs-parent="#faqAcc"><div class="accordion-body">Non. Vous percevez vos revenus pétrole sans parrainer qui que ce soit. Le <%=@prime%> % et les bonus 10/30 filleuls sont simplement une accélérateur.</div></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- RECHARGE CTA -->
<section id="recharge" class="py-5 text-white" style="background:linear-gradient(90deg,var(--usa-blue),var(--usa-red));">
  <div class="container text-center">
    <h2 class="fw-bold mb-3">Rechargez votre compte et recevez vos premiers revenus demain</h2>
    <a class="btn btn-light btn-lg fw-bold px-5 py-3" href="#">RECHARGER MAINTENANT</a>
  </div>
</section>

<!-- FOOTER -->
<footer class="py-4 text-center text-muted bg-light"><small>© 2025 OilUSA – Investissement à risque. Aucune garantie de rendement.</small></footer>

