<!-- app/views/admin/spin_configurations/index.html.erb -->
<% content_for :bonus_tab_content do %>
  <div class="d-flex justify-content-between mb-3">
    <h5>Config spin</h5>

  </div>

              <!-- Contenu -->

              <% provide :title, "Spin - paramètres" %>

              <%= form_with model: @setting, url: admin_spin_setting_path, method: :patch, local: true, class: "mt-3" do |f| %>
                <div class="mb-3 form-check">
                  <%= f.check_box :enabled, class: "form-check-input" %>
                  <%= f.label :enabled, "Activer la roue", class: "form-check-label" %>
                </div>

                <div class="mb-3">
                  <%= f.label :spins_per_day, "Tours autorisés par jour" %>
                  <%= f.number_field :spins_per_day, class: "form-control", min: 0 %>
                </div>

                <div class="mb-3">
                  <%= f.label :point_value_in_francs, "Valeur 1 point → X FCFA" %>
                  <%= f.number_field :point_value_in_francs, class: "form-control", min: 1 %>
                </div>

                <div class="mb-3">
                  <%= f.label :goal_points, "Objectif de points pour réclamer la récompense" %>
                  <%= f.number_field :goal_points, class: "form-control", min: 1 %>
                </div>

                <%= f.submit "Sauvegarder", class: "btn btn-primary" %>
              <% end %>

            
              <!--FIN  Contenu -->
            </div>
        </main>
    </div>
<% end %>

<% content_for :title, "Cases de la roue" %>
<%= render template: 'admin/bonus/index' %>