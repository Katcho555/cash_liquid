        <!-- Modale unique -->
    <div id="uxRuptureModal" class="ux-modal">
        <div class="ux-modal-content">
            <button class="ux-modal-close">&times;</button>
            <div class="ux-modal-icon">
            <i class="fa fa-box-open"></i>
            </div>
            <h4 class="ux-modal-title">Rupture de stock</h4>
            <p class="ux-modal-text">
            Impossible d’ajouter « <span id="uxProductName"></span> » à votre espace.<br>
            Le produit est momentanément indisponible.
            </p>
            <button class="ux-modal-ok">Compris</button>
        </div>
    </div>


        <script>
        // app/assets/javascripts/modal-rupture.js
        document.querySelectorAll('.ux-add-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const available = this.dataset.available === 'true';
            const name = this.dataset.name;

            if (!available) {
            openRuptureModal(name);
            return; // bloque tout traitement
            }

            // Ici ton traitement normal (API, ajout, etc.)
        });
        });

        function openRuptureModal(productName) {
        const modal = document.getElementById('uxRuptureModal');
        const nameSpan = document.getElementById('uxProductName');
        nameSpan.textContent = productName;
        modal.classList.add('show');

        // ferme auto après 4s
        setTimeout(() => closeRuptureModal(), 4000);
        }

        function closeRuptureModal() {
        document.getElementById('uxRuptureModal').classList.remove('show');
        }

        // Fermetures manuelles
        document.querySelector('.ux-modal-close').addEventListener('click', closeRuptureModal);
        document.querySelector('.ux-modal-ok').addEventListener('click', closeRuptureModal);
    </script>