<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Utilisateur</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
            padding-bottom: 80px; /* Espace pour la nav mobile améliorée */
        }
        
        /* Navbar desktop */
        .navbar-desktop {
            display: none;
        }
        
        /* Banner */
        .banner {
            background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), 
                        url('https://images.unsplash.com/photo-1620835085981-251dbffd9f4b?w=1200&h=300&fit=crop') center/cover;
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2rem;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.7);
        }
        
        /* Cards solde et retraits */
        .balance-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 15px;
        }
        
        .withdrawal-card {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            border: none;
            border-radius: 15px;
        }
        
        /* Cards navigation */
        .nav-card {
            height: 150px;
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            margin-bottom: 20px;
            border: none;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: transform 0.3s;
        }
        
        .nav-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 12px rgba(0,0,0,0.15);
        }
        
        .nav-card-recharge {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                        url('https://images.unsplash.com/photo-1553729459-efe14ef6055d?w=400&h=300&fit=crop') center/cover;
        }
        
        .nav-card-retrait {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                        url('https://images.unsplash.com/photo-1551650975-87deedd944c3?w=400&h=300&fit=crop') center/cover;
        }
        
        .nav-card-historique {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                        url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=400&h=300&fit=crop') center/cover;
        }
        
        .nav-card-service {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                        url('https://images.unsplash.com/photo-1556761175-b413da4baf72?w=400&h=300&fit=crop') center/cover;
        }
        
        .nav-card-btn {
            position: absolute;
            bottom: 15px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(255,255,255,0.9);
            border: none;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 600;
            color: #333;
        }
        
        /* Bottom navigation mobile améliorée */
        .mobile-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: white;
            box-shadow: 0 -2px 20px rgba(0,0,0,0.1);
            z-index: 1000;
            padding: 12px 0;
            border-radius: 20px 20px 0 0;
        }
        
        .mobile-nav-item {
            text-align: center;
            color: #999;
            text-decoration: none;
            font-size: 11px;
            padding: 5px;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
        }
        
        .mobile-nav-item:hover {
            color: #667eea;
            transform: translateY(-2px);
        }
        
        .mobile-nav-item.active {
            color: #667eea;
            font-weight: 600;
        }
        
        .mobile-nav-item.active::before {
            content: '';
            position: absolute;
            top: -12px;
            width: 40px;
            height: 3px;
            background: #667eea;
            border-radius: 2px;
        }
        
        .mobile-nav-item i {
            font-size: 22px;
            display: block;
            margin-bottom: 4px;
            transition: all 0.3s ease;
        }
        
        .mobile-nav-item.active i {
            transform: scale(1.1);
            filter: drop-shadow(0 2px 4px rgba(102, 126, 234, 0.3));
        }
        
        /* Badge notification */
        .nav-notification {
            position: absolute;
            top: -5px;
            right: 15px;
            background: #ff4757;
            color: white;
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 10px;
            font-weight: bold;
            min-width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        /* Desktop view */
        @media (min-width: 768px) {
            body {
                padding-bottom: 0;
            }
            
            .navbar-desktop {
                display: flex;
            }
            
            .mobile-nav {
                display: none;
            }
            
            .nav-card {
                margin-bottom: 0;
            }
        }

        /* Animation au chargement */
        .mobile-nav-item {
            animation: slideUp 0.5s ease-out;
        }
        
        @keyframes slideUp {
            from {
                transform: translateY(20px);
                opacity: 0;
            }
            to {
                transform: translateY(0);
                opacity: 1;
            }
        }
    </style>
</head>
<body>
    <!-- Navbar Desktop -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark navbar-desktop">
        <div class="container">
            <a class="navbar-brand" href="#">Dashboard</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="#"><i class="bi bi-house-door"></i> Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-box"></i> Produit</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-people"></i> Équipe</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#"><i class="bi bi-person"></i> Mon compte</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Banner -->
    <div class="banner">
        <div class="text-center">
            <i class="bi bi-fuel-pump"></i> MARCHÉ PÉTROLIER
        </div>
    </div>

    <!-- Main Content -->
    <div class="container my-4">
        <!-- Cards Solde et Retraits -->
        <div class="row mb-4">
            <div class="col-md-6 col-6 mb-3">
                <div class="card balance-card">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-wallet2"></i> Mon Solde</h5>
                        <h2 class="mb-0">5,250.00 €</h2>
                        <small>Disponible</small>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-6 mb-3">
                <div class="card withdrawal-card">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-cash-stack"></i> Mes Retraits</h5>
                        <h2 class="mb-0">1,850.00 €</h2>
                        <small>Ce mois-ci</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Séparation -->
        <hr class="my-4">

        <!-- Cards Navigation -->
        <div class="row">
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-recharge">
                    <button class="nav-card-btn">
                        <i class="bi bi-plus-circle"></i> Recharger
                    </button>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-retrait">
                    <button class="nav-card-btn">
                        <i class="bi bi-arrow-down-circle"></i> Retrait
                    </button>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-historique">
                    <button class="nav-card-btn">
                        <i class="bi bi-clock-history"></i> Historique
                    </button>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-service">
                    <button class="nav-card-btn">
                        <i class="bi bi-headset"></i> Service Client
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile Bottom Navigation Améliorée -->
    <nav class="mobile-nav">
        <div class="container">
            <div class="row">
                <div class="col-3">
                    <a href="#" class="mobile-nav-item active">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Accueil</span>
                    </a>
                </div>
                <div class="col-3">
                    <a href="#" class="mobile-nav-item">
                        <i class="bi bi-box-seam"></i>
                        <span>Produit</span>
                    </a>
                </div>
                <div class="col-3">
                    <a href="#" class="mobile-nav-item">
                        <i class="bi bi-people-fill"></i>
                        <span>Équipe</span>
                        <span class="nav-notification">3</span>
                    </a>
                </div>
                <div class="col-3">
                    <a href="#" class="mobile-nav-item">
                        <i class="bi bi-person-circle"></i>
                        <span>Compte</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Animation au clic sur les éléments de la nav
        document.querySelectorAll('.mobile-nav-item').forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                
                // Retirer la classe active de tous les éléments
                document.querySelectorAll('.mobile-nav-item').forEach(i => {
                    i.classList.remove('active');
                });
                
                // Ajouter la classe active à l'élément cliqué
                this.classList.add('active');
                
                // Ajouter une petite vibration sur mobile (si supporté)
                if ('vibrate' in navigator) {
                    navigator.vibrate(50);
                }
            });
        });
    </script>
</body>
</html>