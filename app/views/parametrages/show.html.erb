<!-- ===== DASHBOARD USER – COMPLET ===== -->
<div class="ux-dashboard">
  <!-- Sidebar -->
  

     <%if current_user.admin?%>
        <%= render partial: "layouts/sidebar/admin" %>
    <%else%>
        <%= render partial: "layouts/sidebar/utilisateur" %>
    <%end%>

    <!-- Main -->
        <main class="ux-main">

            <%= render partial: "layouts/card_entete"%>

            <!-- Contenu -->
            <div class="ux-content p-3 p-lg-4">
              <!-- Contenu -->

                <div class="flex-grow-1">
                    <div class="card shadow border-0 rounded-3">
                    <div class="card-header bg-primary text-white d-flex align-items-center">
                        <i class="bi bi-gear-fill me-2"></i>
                        <h5 class="mb-0">Paramètres généraux du système</h5>
                    </div>

                    <div class="card-body p-4">
                    <% if notice %>
                        <div class="alert alert-success"><%= notice %></div>
                    <% elsif alert %>
                        <div class="alert alert-danger"><%= alert %></div>
                    <% end %>

                    <!-- Formulaire paramètres généraux -->
                    <%= form_with url: parametrage_path, method: :patch, local: true do %>
                        <div class="mb-4">
                            <label class="form-label fw-semibold"><i class="bi bi-currency-dollar me-1 text-success"></i> Prix du dollar (FCFA)</label>
                            <input type="number" step="0.01" min="0" name="taux_dollar" value="<%= @taux_dollar.valeur %>" class="form-control w-100">
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold"><i class="bi bi-gift-fill me-1 text-warning"></i> Prime parrainage (%)</label>
                            <input type="number" min="0" name="prime_parrainage" value="<%= @prime_parrainage.valeur %>" class="form-control w-100">
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold"><i class="bi bi-money me-1 text-warning"></i> Taux de retrait (%)</label>
                            <input type="number" min="0" name="taux_retrait" value="<%= @taux_retrait.valeur %>" class="form-control w-100">
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold"><i class="bi bi-envelope-fill me-1 text-primary"></i> Email d’administration</label>
                            <input type="email" name="email_admin" value="<%= @email_admin.valeur %>" class="form-control w-100">
                        </div>

                        <button type="submit" class="btn btn-primary px-4 mb-4">
                            <i class="bi bi-check-circle me-1"></i> Mettre à jour les paramètres
                        </button>
                    <% end %>

                    </div>
                    </div>
                </div>

            <!--FIN  Contenu -->
            </div>
        </main>
    </div>




<script>
  document.addEventListener("turbo:load", function() {
    const input = document.getElementById("searchInput");
    const table = document.getElementById("usersTable");
    input.addEventListener("keyup", function() {
      const filter = input.value.toLowerCase();
      const rows = table.getElementsByTagName("tr");

      for(let i = 1; i < rows.length; i++) { // Skip header row
        const row = rows[i];
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? "" : "none";
      }
    });
  });
</script>
