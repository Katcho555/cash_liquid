<style>
  <style>
  .table {
    --bs-table-bg: transparent;
    --bs-table-striped-bg: rgba(0, 0, 0, 0.02);
  }
  
  .table-hover tbody tr:hover {
    background-color: rgba(0, 123, 255, 0.05) !important;
  }
  
  .card {
    border-radius: 12px;
  }
  
  .card-header hr {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  
  .badge.bg-success {
    background-color: #28a745 !important;
  }
  
  .badge.bg-danger {
    background-color: #dc3545 !important;
  }
  
  .btn-group-sm .btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.765rem;
  }
</style>

<div class="ux-dashboard">
  <!-- Sidebar -->
     <%if current_user.admin?%>
        <%= render partial: "layouts/sidebar/admin" %>
    <%else%>
        <%= render partial: "layouts/sidebar/utilisateur" %>
    <%end%>

    <!-- Main -->
        <main class="ux-main">

            <%= render partial: "layouts/card_entete"%>

            <!-- Contenu -->
            <div class="ux-content p-3 p-lg-4">
              <!-- Contenu -->


                <div class="bg-white tw-px-8 tw-py-8 rounded-3">

                    <div class="container-fluid py-4">
                      <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-0 pb-0">
                          <div class="d-flex justify-content-between align-items-center">
                            <h1 class="h3 mb-0">Gestion des utilisateurs</h1>
                            <%= link_to "Nouvel utilisateur", new_admin_user_path, class: "btn btn-primary" if current_user.admin? %>
                          </div>
                          <hr class="mt-3">
                        </div>
                        
                        <div class="card-body px-0 py-2">
                          <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                              <thead class="table-light">
                                <tr>
                                  <th class="ps-4">Nom</th>
                                  <th>Email</th>
                                  <th>Statut</th>
                                  <th class="text-end pe-4">Actions</th>
                                </tr>
                              </thead>
                              <tbody>
                                <% @users.each do |u| %>
                                  <tr class="<%= 'table-warning' if u.blocked? %>">
                                    <td class="ps-4 fw-medium"><%= u.nom %> <%= u.prenom %></td>
                                    <td><%= u.email %></td>
                                    <td>
                                      <span class="badge <%= u.blocked? ? 'bg-danger' : 'bg-success' %> rounded-pill">
                                        <%= u.blocked? ? "Bloqué" : "Non bloqué" %>
                                      </span>
                                    </td>
                                    <td class="text-end pe-4">
                                      <div class="btn-group btn-group-sm" role="group">
                                        <%= link_to "Voir", admin_user_path(u), class: "btn btn-outline-primary" %>
                                        <% if u.blocked? %>
                                          <%= button_to "Débloquer", unblock_admin_user_path(u), method: :patch, 
                                              class: "btn btn-outline-success", form_class: "d-inline" %>
                                        <% else %>
                                          <%= button_to "Bloquer", block_admin_user_path(u), method: :patch, 
                                              class: "btn btn-outline-danger", form_class: "d-inline" %>
                                        <% end %>
                                      </div>
                                    </td>
                                  </tr>
                                <% end %>
                              </tbody>
                            </table>
                            <div class="d-flex justify-content-center mt-3">
                              <%= paginate @users %>
                          </div>
                          </div>
                        </div>
                       
                      </div>
                    


                    </div>

                </div>
             <!--FIN  Contenu -->
            </div>
        </main>
    </div>