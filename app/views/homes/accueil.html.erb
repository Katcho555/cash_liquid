    <style>
        :root {
            --bg-color: #FAFBFC;
            --primary-color: #1A1D29;
            --secondary-color: #4A5568;
            --accent-color: #D69E2E;
            --glass-bg: rgba(255, 255, 255, 0.95);
            --glass-border: rgba(255, 255, 255, 0.2);
        }
        
        body {
            font-family: 'Quattrocento Sans', sans-serif;
            background-color: var(--bg-color);
            color: var(--primary-color);
            overflow-x: hidden;
        }
        

        .hero-title {
            font-family: 'Hedvig Letters Sans', sans-serif;
            font-size: 50px;
            font-weight: bold;
            line-height: 1.1;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--accent-color) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .hero-subtitle {
            font-family: 'Liter', sans-serif;
            font-size: clamp(1.2rem, 3vw, 1.8rem);
            color: var(--secondary-color);
            line-height: 1.6;
        }
        
        .vanta-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }
        
        .glass-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.1);
        }
        
        .glass-navbar {
            background: var(--glass-bg) !important;
            backdrop-filter: blur(20px) !important;
            border-bottom: 1px solid var(--glass-border) !important;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1) !important;
        }
        
        .feature-card {
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            border: none;
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
        }
        
        .feature-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15) !important;
        }
        
        .btn-primary-custom {
            background: linear-gradient(135deg, var(--accent-color) 0%, #B7791F 100%);
            color: white;
            padding: 16px 32px;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(214, 158, 46, 0.3);
            border: none;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 40px rgba(214, 158, 46, 0.4);
            color: white;
        }
        
        .stats-number {
            font-family: 'Hedvig Letters Sans', sans-serif;
            font-size: 3rem;
            font-weight: 700;
            color: var(--accent-color);
        }
        
        .floating-element {
            animation: float 6s ease-in-out infinite;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        
        .scroll-reveal {
            opacity: 0;
            transform: translateY(50px);
            transition: all 0.8s ease;
        }
        
        .scroll-reveal.revealed {
            opacity: 1;
            transform: translateY(0);
        }
        
     
        
        .animated-icon {
            width: 30px;
            height: 20px;
            position: relative;
            margin: 0;
            transform: rotate(0deg);
            transition: .5s ease-in-out;
            cursor: pointer;
        }
        
        .animated-icon span {
            display: block;
            position: absolute;
            height: 3px;
            width: 100%;
            background: var(--accent-color);
            border-radius: 9px;
            opacity: 1;
            left: 0;
            transform: rotate(0deg);
            transition: .25s ease-in-out;
        }
        
        .animated-icon span:nth-child(1) {
            top: 0px;
        }
        
        .animated-icon span:nth-child(2) {
            top: 10px;
        }
        
        .animated-icon span:nth-child(3) {
            top: 20px;
        }
        
        .animated-icon.open span:nth-child(1) {
            top: 11px;
            transform: rotate(135deg);
        }
        
        .animated-icon.open span:nth-child(2) {
            opacity: 0;
            left: -60px;
        }
        
        .animated-icon.open span:nth-child(3) {
            top: 11px;
            transform: rotate(-135deg);
        }
        
       
        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .hero-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }
        
        .feature-icon {
            width: 64px;
            height: 64px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
            font-size: 1.5rem;
            color: white;
        }
        
        .gradient-blue {
            background: linear-gradient(135deg, #3B82F6 0%, #1E40AF 100%);
        }
        
        .gradient-amber {
            background: linear-gradient(135deg, #F59E0B 0%, #B45309 100%);
        }
        
        .gradient-green {
            background: linear-gradient(135deg, #10B981 0%, #047857 100%);
        }
        
  
        
        @media (max-width: 767.98px) {
          
        @media (max-width: 979.98px) {
            .hero-section {
                margin-top: 100px;
            }
        }
        
        .cta-section {
            background: linear-gradient(135deg, var(--accent-color) 0%, #B7791F 100%);
            color: white;
        }
        
        .btn-white {
            background: white;
            color: var(--accent-color);
            border: 2px solid white;
            padding: 16px 32px;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-white:hover {
            background: transparent;
            color: white;
            border-color: white;
        }
        
        .btn-outline-white {
            background: transparent;
            color: white;
            border: 2px solid white;
            padding: 16px 32px;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
        }
        
        .btn-outline-white:hover {
            background: white;
            color: var(--accent-color);
        }
    </style>

     <style>
        :root {
            --primary-colore: #f59e0b;
            --primary-dark: #d97706;
            --primary-light: #fef3c7;
            --text-dark: #1f2937;
            --text-light: #6b7280;
            --bg-light: #f9fafb;
            --sidebar-width: 320px;
        }
        
      
        
        /* Navigation principale - Version PC */
        .glass-navbar {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.08);
            padding: 1rem 0;
            transition: all 0.4s ease;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }
        
        .glass-navbar.scrolled {
            background: rgba(255, 255, 255, 0.98);
            padding: 0.7rem 0;
        }
        
        .navbar-brand {
            font-weight: 800;
            color: var(--text-dark) !important;
            font-size: 1.8rem;
            letter-spacing: -0.5px;
        }
        
        .logo-container {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
        }
        
        .logo-container i {
            color: white;
            font-size: 1.3rem;
        }
        
        /* Menu principal PC - Design spécial */
        .nav-main {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(245, 158, 11, 0.05);
            border-radius: 50px;
            padding: 0.5rem;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(245, 158, 11, 0.1);
        }
        
        .nav-item-pc {
            position: relative;
        }
        
        .nav-link-pc {
            color: var(--text-dark) !important;
            font-weight: 600;
            padding: 0.7rem 1.5rem !important;
            border-radius: 50px;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
            text-decoration: none;
            display: block;
        }
        
        .nav-link-pc:hover {
            color: var(--text-dark) !important;
        }
        
        .nav-indicator {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--primary-colore), var(--primary-dark));
            border-radius: 50px;
            z-index: 0;
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
        }
        
        .nav-link-pc.active {
            color: white !important;
        }
        
        /* Boutons actions */
        .nav-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .btn-connect {
            color: var(--text-dark) !important;
            font-weight: 600;
            text-decoration: none;
            padding: 0.7rem 1.5rem;
            border-radius: 50px;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }
        
        .btn-connect:hover {
            border-color: var(--primary-colore);
            color: var(--primary-colore) !important;
        }
        
        .btn-primary-custom {
            background: linear-gradient(135deg, var(--primary-colore), var(--primary-dark));
            color: white !important;
            border: none;
            padding: 0.7rem 2rem;
            border-radius: 50px;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
        }
        
        .btn-primary-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(245, 158, 11, 0.4);
            color: white;
        }
        
        /* Bouton menu mobile */
        .menu-trigger {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-colore), var(--primary-dark));
            border: none;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
        }
        
        .menu-trigger:hover {
            transform: rotate(90deg);
            box-shadow: 0 6px 20px rgba(245, 158, 11, 0.4);
        }
        
        /* Offcanvas - Version Mobile */
        .offcanvas-special {
            background: linear-gradient(135deg, #1f2937 0%, #374151 100%);
            color: white;
            width: 100vw !important;
            border-left: none !important;
        }
        
        @media (min-width: 400px) {
            .offcanvas-special {
                width: 380px !important;
            }
        }
        
        .offcanvas-header {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 2rem 1.5rem 1.5rem;
        }
        
        .offcanvas-brand {
            font-weight: 800;
            font-size: 1.8rem;
            color: white;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        .offcanvas-logo {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, var(--primary-colore), var(--primary-dark));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .btn-close-custom {
            background: none;
            border: none;
            color: white;
            font-size: 1.5rem;
            opacity: 0.7;
            transition: all 0.3s ease;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .btn-close-custom:hover {
            opacity: 1;
            background: rgba(255, 255, 255, 0.1);
        }
        
        /* Navigation mobile */
        .offcanvas-body {
            padding: 2rem 1.5rem;
        }
        
        .nav-mobile {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .nav-link-mobile {
            color: rgba(255, 255, 255, 0.8);
            font-weight: 600;
            padding: 1rem 1.5rem;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 1rem;
            border: 1px solid transparent;
        }
        
        .nav-link-mobile:hover,
        .nav-link-mobile.active {
            color: white;
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateX(5px);
        }
        
        .nav-link-mobile i {
            width: 20px;
            text-align: center;
            font-size: 1.1rem;
        }
        
        .nav-divider {
            height: 1px;
            background: rgba(255, 255, 255, 0.1);
            margin: 1.5rem 0;
        }
        
        .user-section {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 1.5rem;
            margin-top: 2rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .user-avatar {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-colore), var(--primary-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: white;
            margin-bottom: 1rem;
        }
        
        /* Section de démonstration */
        .demo-section {
            padding: 6rem 2rem 2rem;
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
            min-height: 100vh;
        }
        
        .demo-section h1 {
            color: var(--text-dark);
            margin-bottom: 1rem;
            font-weight: 800;
        }
        
        .demo-section p {
            color: var(--text-light);
            margin-bottom: 2rem;
            font-size: 1.1rem;
        }
        
        .scroll-indicator {
            margin-top: 3rem;
            color: var(--primary-color);
            animation: bounce 2s infinite;
        }
        
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {
                transform: translateY(0);
            }
            40% {
                transform: translateY(-10px);
            }
            60% {
                transform: translateY(-5px);
            }
        }
        
        /* Cacher le menu PC sur mobile et vice versa */
        @media (max-width: 991px) {
            .nav-pc {
                display: none !important;
            }
        }
        
        @media (min-width: 992px) {
            .menu-trigger {
                display: none !important;
            }
        }

        
        /* Animation douce */
        [data-aos] {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.6s ease;
        }

        [data-aos].aos-animate {
        opacity: 1;
        transform: translateY(0);
        }

        footer a{
            color: white;
        }
 
    </style>

 

