                  <% end %>
                  </div>
              <% end %>
            </div>
            <hr>
            <div class="text-center mt-4 mb-4">
              <a href="<%=retraits_path%>" class="ux-btn-submit" style="text-decoration:none;">
                Historique de mes retraits
              </a>
            </div>
        <!--FIN  Contenu -->
    <div>
    <%= render partial: "layouts/footer_admin"%>
  </div>


<%end%>





<!-- Modal blocage -->
<div class="modal fade" id="inactifModal" tabindex="-1" aria-labelledby="inactifModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="inactifModalLabel">Souscription requise</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body">
        Pour effectuer un retrait, vous devez d’abord souscrire. Cliquez ci-dessous pour accéder à la souscription.
      </div>
      <div class="modal-footer">
        <a href="<%= souscriptions_path %>" class="btn btn-primary">Souscrire maintenant</a>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const inputMontant = document.getElementById("montant_retrait");
    const affichageNet = document.getElementById("montant_net_affiche");
    const taux = <%= @taux_retrait || 10 %>;

    if (inputMontant && affichageNet) {
      inputMontant.addEventListener("input", function() {
        const montant = parseFloat(this.value) || 0;
        const montantNet = montant - (montant * taux / 100);
        affichageNet.textContent = montantNet.toLocaleString("fr-FR", { minimumFractionDigits: 0 });
      });
    }
  });
</script>