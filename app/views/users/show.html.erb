<style>
    <style>
  .profile-card {
    max-width: 600px;
    margin: 0 auto;
    border-radius: 10px;
    overflow: hidden;
    border: none;
  }
  
  .card-header {
    border-radius: 10px 10px 0 0 !important;
    padding: 1.25rem;
  }
  
  .user-details {
    padding: 0 1rem;
  }
  
  .detail-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .detail-label {
    width: 40%;
  }
  
  .detail-value {
    width: 60%;
    text-align: right;
  }
  
  @media (max-width: 576px) {
    .detail-item {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .detail-label, 
    .detail-value {
      width: 100%;
      text-align: left;
    }
    
    .detail-value {
      margin-top: 0.25rem;
    }
  }
</style>

