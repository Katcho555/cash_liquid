
    <style>
      a{
        text-decoration: none;
      }
    .bg-gradient-primary {
    background: linear-gradient(135deg, #0d6efd, #0a58ca);
    }

    .action-card {
    border: 0;
    box-shadow: 0 .125rem .25rem rgba(0,0,0,.075);
    transition: transform .2s ease, box-shadow .2s ease;
    }

    .action-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
    }
    /* Cards solde et retraits */
    .balance-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 15px;
    }
    
    .withdrawal-card {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        border: none;
        border-radius: 15px;
    }
    
    /* Cards navigation */
    .nav-card {
        height: 150px;
        border-radius: 15px;
        overflow: hidden;
        position: relative;
        margin-bottom: 20px;
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: transform 0.3s;
    }
    
    .nav-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 12px rgba(0,0,0,0.15);
    }
    
    .nav-card-recharge {
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                    url('https://images.unsplash.com/photo-1553729459-efe14ef6055d?w=400&h=300&fit=crop') center/cover;
    }
    
    .nav-card-retrait {
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                    url('https://images.unsplash.com/photo-1551650975-87deedd944c3?w=400&h=300&fit=crop') center/cover;
    }
    
    .nav-card-historique {
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                    url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=400&h=300&fit=crop') center/cover;
    }
    
    .nav-card-service {
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                    url('https://images.unsplash.com/photo-1556761175-b413da4baf72?w=400&h=300&fit=crop') center/cover;
    }
    
    .nav-card-btn {
        position: absolute;
        bottom: 15px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(255,255,255,0.9);
        border: none;
        padding: 8px 20px;
        border-radius: 20px;
        font-weight: 600;
        color: #333;
    }
</style>

<div class="dash-body">


<%= render partial: "layouts/header_admin"%>

    <!-- Main Content -->
    <div class="container my-4">

  <div class="row g-3 mb-4">

    <!-- SOLDE -->
    <div class="col-md-6">
      <div class="card shadow-sm border-0 bg-gradient-primary text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <small class="text-white-50">Solde disponible</small>
              <h2 class="fw-bold mt-1 mb-0">
                <% if current_user.admin? %>
                  <%= number_with_delimiter(@total_gain + User.first.balance) %>
                <% else %>
                  <%= number_with_delimiter(current_user.balance) %>
                <% end %>
                <span class="fs-6">FCFA</span>
              </h2>
            </div>
            <i class="bi bi-wallet2 fs-1 opacity-75"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- RETRAITS -->
    <div class="col-md-6">
      <div class="card shadow-sm border-0 bg-warning h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <small class="text-muted">Retraits validés</small>
              <h3 class="fw-semibold mt-1 mb-0 text-dark">
                <%= number_with_delimiter(
                      current_user.retraits.where(statut: 'Validé').sum(:montant)
                    ) %>
                <span class="fs-6">FCFA</span>
              </h3>
            </div>
            <i class="bi bi-cash-stack fs-1 text-success opacity-75"></i>
          </div>
        </div>
      </div>
    </div>

  </div>

    <div class="container my-4">
        <!-- Cards Navigation -->
        <div class="row">
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-recharge">
                    <a href="<%=products_path%>" class="nav-card-btn">
                        <i class="bi bi-plus-circle"></i> Recharger
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-retrait">
                    <a href="<%=new_retrait_path%>" class="nav-card-btn">
                        <i class="bi bi-arrow-down-circle"></i> Retrait
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-historique">
                    <a href="<%=my_subscriptions_subscriptions_path%>" class="nav-card-btn">
                        <i class="bi bi-clock-history"></i> Investissement
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-service">
                    <button class="nav-card-btn">
                        <i class="bi bi-headset"></i> Contact
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- SECTION AVANTAGES / PUBLICITÉ -->
<section class="container my-5">

  <div class="text-center mb-4">
    <h5 class="fw-bold">Pourquoi investir avec nous ?</h5>
    <p class="text-muted mb-0">
      Des opportunités fiables, transparentes et rentables
    </p>
  </div>

  <div class="row g-4">

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 text-center p-3">
        <i class="bi bi-shield-check text-success fs-1 mb-3"></i>
        <h6 class="fw-semibold">Investissement sécurisé</h6>
        <p class="text-muted small">
          Vos fonds sont gérés avec transparence et traçabilité.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 text-center p-3">
        <i class="bi bi-graph-up-arrow text-primary fs-1 mb-3"></i>
        <h6 class="fw-semibold">Rendements attractifs</h6>
        <p class="text-muted small">
          Profitez de revenus journaliers sur des projets réels.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 text-center p-3">
        <i class="bi bi-people-fill text-warning fs-1 mb-3"></i>
        <h6 class="fw-semibold">Parrainage rémunéré</h6>
        <p class="text-muted small">
          Gagnez des commissions grâce à votre réseau.
        </p>
      </div>
    </div>

  </div>
</section>

<section class="container my-5">
  <div class="card bg-dark text-white shadow-sm">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap">
      <div>
        <h5 class="mb-1">Nouvelle opportunité d’investissement disponible</h5>
        <small class="text-white-50">
          Profitez dès maintenant des rendements journaliers
        </small>
      </div>
      <a href="#" class="btn btn-warning mt-3 mt-md-0" data-bs-toggle="modal" data-bs-target="#cguModal">
        Conditions d’utilisation
      </a>
    </div>
  </div>
</section>

<style>
  .mission-card {
    border-radius: 14px;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .mission-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,.1);
  }

</style>

<div class="container my-5">
  <h4 class="fw-bold mb-3">
    🎯 Missions de bonus
  </h4>

 <% if @bonus_missions.any? %>
  <div class="row g-3">
    <% @bonus_missions.each do |mission| %>
      <% campaign = mission.bonus_campaign %>
      <% percent = [(mission.progress.to_f / campaign.threshold) * 100, 100].min %>

      <div class="col-md-4">
        <div class="card mission-card shadow-sm">
          <div class="card-body">
            <h6 class="fw-bold mb-2"><%= campaign.name %></h6>
            <p class="small text-muted mb-2">
              Parrainer <strong><%= campaign.threshold %></strong> filleuls actifs
            </p>

            <div class="progress mb-2" style="height: 8px;">
              <div class="progress-bar bg-success" style="width: <%= percent %>%"></div>
            </div>

            <small class="text-muted"><%= mission.progress %> / <%= campaign.threshold %> filleuls</small>

            <div class="mt-3 d-flex justify-content-between align-items-center">
              <span class="badge bg-primary">🎁 <%= number_with_delimiter(campaign.reward_amount) %> FCFA</span>

              <% if mission.locked %>
                 <% if mission.ready_to_claim? %>
                  <%= button_to "Obtenir ma récompense", claim_reward_bonus_mission_path(mission),
                        method: :post, class: "btn btn-success mt-2" %>
                <% elsif mission.rewarded? %>
                  <span class="badge bg-primary mt-2">Récompense obtenue 🎉</span>
                <% else %>
                  <span class="badge bg-secondary mt-2">En cours</span>
                <% end %>
              <% else %>
                <span class="text-secondary small">Nouvelle mission</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
    <!-- Aucun mission -->
    <div class="alert alert-light text-center py-5">
      <i class="bi bi-emoji-neutral fs-1 text-muted"></i>
      <p class="mt-3 mb-0 text-muted">
        Aucune mission de bonus disponible aujourd’hui
      </p>
    </div>
  <% end %>
</div>



   <%= render partial: "layouts/footer_admin"%>

</div>

<div class="modal fade" id="cguModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class="modal-content cgu-modal">

      <!-- Header -->
      <div class="modal-header cgu-header">
        <h5 class="modal-title">
          📜 Conditions Générales d’Utilisation
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <!-- Body -->
      <div class="modal-body">
        <ul class="nav nav-pills cgu-tabs mb-3" role="tablist">
          <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-cgu">
              A propos
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-privacy">
              Fonctionnement
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-responsibility">
              Parrainage
            </button>
          </li>
        </ul>

        <div class="tab-content">

          <!-- CGU -->
          <div class="tab-pane fade show active" id="tab-cgu">
            <h6> Découvrez l'excellence pétrolière américaine ! </h6>

              <p> Je suis ravi de vous inviter à investir en toute securité dans le pétrole. CASH LIQUID est une branche chargée de la gestion des investissements pétroliers de la raffinerie de Baytown, l'une des plus grandes et des plus modernes raffineries pétrolières des États-Unis, située au cœur du Texas.</p>  

               <h6>À propos de la raffinerie de Baytown</h6>

              La raffinerie de Baytown est l'une des plus grandes raffineries d'ExxonMobil, avec une capacité de production de 564 440 barils par jour. Elle est située sur la rivière San Jacinto, à proximité de la ville de Houston, et couvre une superficie de plus de 4 000 hectares.</p>

              <h6>Ce que vous découvriez savoir sur CASH LIQUID </h6>

             <p> Une nouvelle ère dans un nouveau monde c'est simplement l'idéal. Depuis sa création en 1920 par la société Humble Oil, la raffinerie de Baytown ne cesse d'innover dans le domaine pétrolier. Elle à depuis 1949 installé un système numérique international permettant à toute personne désireuse d'investir dans le pétrole d'avoir facilement accès face à la concurrence et vu la peine des habitants de certains États relativement à leurs emplacements. Ainsi , est née ''CASH LIQUID '' cette branche de la raffinerie de Baytown qui vient braver la peur, briser les frontières, faire disparaitre l'obligation du voyage avant d'avoir accès à un investissement sûr. 
              Aujourd'hui, depuis chez vous investissez et gagner à travers CASH LIQUID dans le pétrole de la raffinerie américaine Baytown avec une vraie prise en charge par un service décentralisé et bien assuré. Avec des contrats différents à durée déterminée faites l'expérience la explosante de votre vie dans le pétrole américain.</p>

          </div>

          <!-- Confidentialité -->
          <div class="tab-pane fade" id="tab-privacy">
            <h6>Comment investir ?</h6>
            <ul>
              <li>Inscrivez-vous à la plateforme universelle www.cash-liquid.com</li>
              <li>Choisissez votre investissement selon votre capacité </li>
              <li>Recevez les retours sur investissement jusqu'à échéance du contrat renouvelable.</li>
            </ul>

            <h6> Sécurité</h6>
            <ul>
              <li>vos données et informations sont très bien stockées et protégées</li>
              <li>votre investissement est impérativement suivi et servi jusqu'à échéance du contrat </li>
            </ul>
          </div>

          <!-- Responsabilités -->
          <div class="tab-pane fade" id="tab-responsibility">
            <h6>Parrainage</h6>
            <p>
              Parrainer n'est pas nécessaire.Nonobstant,vu qu'invité un ami, un frère ou juste une connaissance à gagner des revenus en investissant dans un environnement de sûreté n'est rien de plus qu'un geste de fraternité et d'amour, nous vous renvoyons l'ascenseur en permettant à tous membres de gagner 5% du 1er  investissement de celui parrainer.
              <br>
              Nous sommes impatients de vous accueillir à la raffinerie de Baytown !
              <br>
              Cordialement😊
            </p>
          </div>

        </div>
      </div>

      <!-- Footer -->
      <div class="modal-footer cgu-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          Fermer
        </button>
        <button type="button" class="btn btn-success" id="acceptCGU">
          J’accepte
        </button>
      </div>

    </div>
  </div>
</div>
