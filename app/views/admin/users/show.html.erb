<style>
  <style>
  .table {
    --bs-table-bg: transparent;
    --bs-table-striped-bg: rgba(0, 0, 0, 0.02);
  }
  
  .table-hover tbody tr:hover {
    background-color: rgba(0, 123, 255, 0.05) !important;
  }
  
  .card {
    border-radius: 12px;
  }
  
  .card-header hr {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  
  .badge.bg-success {
    background-color: #28a745 !important;
  }
  
  .badge.bg-danger {
    background-color: #dc3545 !important;
  }
  
  .btn-group-sm .btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.765rem;
  }
</style>

<div class="ux-dashboard">
  <!-- Sidebar -->
     <%if current_user.admin?%>
        <%= render partial: "layouts/sidebar/admin" %>
    <%else%>
        <%= render partial: "layouts/sidebar/utilisateur" %>
    <%end%>

    <!-- Main -->
        <main class="ux-main">

            <%= render partial: "layouts/card_entete"%>

            <!-- Contenu -->
            <div class="ux-content p-3 p-lg-4">
              <!-- Contenu -->


                <div class="bg-white tw-px-8 tw-py-8 rounded-3">

                    <div class="container my-5">
                        <div class="card shadow-lg border-0 rounded-4">
                            <div class="card-header bg-primary text-white rounded-top-4">
                            <h3 class="mb-0">
                                <i class="bi bi-person-circle me-2"></i> Profil utilisateur
                            </h3>
                            </div>

                            <div class="card-body p-4">
                            <dl class="row mb-0">
                                <dt class="col-sm-3 fw-bold">Nom complet :</dt>
                                <dd class="col-sm-9"><%= @user.nom %> <%= @user.prenom %></dd>

                                <dt class="col-sm-3 fw-bold">Email :</dt>
                                <dd class="col-sm-9"><%= @user.email %></dd>

                                <dt class="col-sm-3 fw-bold">Téléphone :</dt>
                                <dd class="col-sm-9"><%= @user.telephone.presence || "Non renseigné" %></dd>

                                <dt class="col-sm-3 fw-bold">Rôle :</dt>
                                <dd class="col-sm-9">
                                <span class="badge <%= @user.role == 'admin' ? 'bg-danger' : 'bg-info' %>">
                                    <%= @user.role.capitalize %>
                                </span>
                                </dd>

                                <dt class="col-sm-3 fw-bold">Compte bloqué :</dt>
                                <dd class="col-sm-9">
                                <% if @user.blocked? %>
                                    <span class="badge bg-danger">Oui</span>
                                <% else %>
                                    <span class="badge bg-success">Non</span>
                                <% end %>
                                </dd>

                                <dt class="col-sm-3 fw-bold">Statut compte :</dt>
                                <dd class="col-sm-9">
                                <% if @user.compte_status %>
                                    <span class="badge bg-success">Actif</span>
                                <% else %>
                                    <span class="badge bg-secondary">Inactif</span>
                                <% end %>
                                </dd>
                            </dl>
                            </div>

                            <div class="card-footer bg-light d-flex justify-content-between rounded-bottom-4">
                            <div>
                                <% if @user.blocked? %>
                                <%= button_to "Débloquer", unblock_admin_user_path(@user), method: :patch,
                                    class: "btn btn-outline-success btn-sm me-2", form_class: "d-inline" %>
                                <% else %>
                                <%= button_to "Bloquer", block_admin_user_path(@user), method: :patch,
                                    class: "btn btn-outline-danger btn-sm me-2", form_class: "d-inline" %>
                                <% end %>
                            </div>
                            <div>
                                <%= link_to "Modifier", edit_admin_user_path(@user), class: "btn btn-primary btn-sm" %>
                                <%= link_to "Retour à la liste", admin_users_path, class: "btn btn-secondary btn-sm ms-2" %>
                            </div>
                            </div>
                        </div>
                    </div>

                </div>
<!-- ========================= my profile account tabe section end ======================== --> 
               <!--FIN  Contenu -->
            </div>
        </main>
    </div>
