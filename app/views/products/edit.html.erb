<!-- ===== DASHBOARD USER – COMPLET ===== -->
<div class="ux-dashboard">
  <!-- Sidebar -->
  

     <%if current_user.admin?%>
        <%= render partial: "layouts/sidebar/admin" %>
    <%else%>
        <%= render partial: "layouts/sidebar/utilisateur" %>
    <%end%>

    <!-- Main -->
        <main class="ux-main">

            <%= render partial: "layouts/card_entete"%>

            <!-- Contenu -->
            <div class="ux-content p-3 p-lg-4">
              
              <h1 class="text-center">Modifier le produit</h1>

              <%= render "form", product: @product %>

              <br>

              <div>
                <%= link_to "Voir le produit", @product %> |
                <%= link_to "Retour au produit", products_path %>
              </div>
            <!--FIN  Contenu -->
            </div>
        </main>
    </div>

