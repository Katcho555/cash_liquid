                                        </div>
                                    </td>

                                    <td class="text-muted"><%= user.email %></td>
                                    <td>
                                        <% if user.parrain %>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-person-check-fill text-success me-1"></i>
                                            <%= user.parrain.nom_complet %>
