<div class="ux-dashboard">
  <!-- Sidebar -->
     <%if current_user.admin?%>
        <%= render partial: "layouts/sidebar/admin" %>
    <%else%>
        <%= render partial: "layouts/sidebar/utilisateur" %>
    <%end%>

    <!-- Main -->
        <main class="ux-main">

            <%= render partial: "layouts/card_entete"%>

            <!-- Contenu -->
            <div class="ux-content p-3 p-lg-4">
              <!-- Contenu -->

                      <div class="card shadow-lg border-0 rounded-4">
                        <div class="card-header bg-primary text-white rounded-top-4">
                          <h3 class="mb-0">Modifier mon profil</h3>
                        </div>
                        <div class="card-body p-4">
                          
                          <%= form_for(resource, as: resource_name, url: profil_path, html: { method: :put }) do |f| %>

                            <% if resource.errors.any? %>
                              <div class="alert alert-danger">
                                <h5 class="alert-heading">Erreurs :</h5>
                                <ul class="mb-0">
                                  <% resource.errors.full_messages.each do |msg| %>
                                    <li><%= msg %></li>
                                  <% end %>
                                </ul>
                              </div>
                            <% end %>

                            <div class="row">
                              <div class="col-md-6 mb-3">
                                <%= f.label :nom, class: "form-label fw-bold" %>
                                <%= f.text_field :nom, class: "form-control" %>
                              </div>

                              <div class="col-md-6 mb-3">
                                <%= f.label :prenom, class: "form-label fw-bold" %>
                                <%= f.text_field :prenom, class: "form-control" %>
                              </div>
                            </div>

                            <div class="mb-3">
                              <%= f.label :telephone, class: "form-label fw-bold" %>
                              <%= f.text_field :telephone, class: "form-control" %>
                            </div>

                            <div class="mb-3">
                              <%= f.label :email, class: "form-label fw-bold" %>
                              <%= f.email_field :email, class: "form-control" %>
                            </div>

                            <hr class="my-4">

                            <h5 class="mb-3 text-primary fw-bold">Changer le mot de passe</h5>
                            
                            <div class="mb-3">
                              <%= f.label :password, "Nouveau mot de passe (laisser vide si inchangé)", class: "form-label fw-bold" %>
                              <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
                            </div>

                            <div class="mb-3">
                              <%= f.label :password_confirmation, "Confirmation", class: "form-label fw-bold" %>
                              <%= f.password_field :password_confirmation, class: "form-control" %>
                            </div>

                            <div class="mb-3">
                              <%= f.label :current_password, "Mot de passe actuel (obligatoire pour toute modification)", class: "form-label fw-bold" %>
                              <%= f.password_field :current_password, class: "form-control", autocomplete: "current-password" %>
                            </div>

                            <div class="d-flex justify-content-end">
                              <%= f.submit "Mettre à jour", class: "btn btn-primary px-4" %>
                            </div>

                          <% end %>
                        </div>
                      </div>
                          <!--FIN  Contenu -->
            </div>
        </main>
    </div>