<style>
  /* ===== VARIABLES NEON ===== */
:root{
  --neon-pink :#ff2a6d;
  --neon-blue :#05d9e8;
  --neon-purple:#d1d7ff;
  --dark-bg   :#0d0f18;
  --dark-card :#131622;
  --border    :1px solid rgba(5, 217, 232, .3);
}

/* ===== HERO NEON ===== */
.bonus-hero{
  background: radial-gradient(ellipse at top, #1a1a2e 0%, #0d0f18 70%),
              linear-gradient(180deg, rgba(255,42,109,.15) 0%, transparent 100%);
  border-bottom: var(--border);
  text-align:center;
  padding:3rem 1rem;
  position:relative;
  overflow:hidden;
}
.bonus-hero::before{                    // scan-line
  content:"";
  position:absolute;
  top:0; left:0; right:0; height:2px;
  background:var(--neon-blue);
  box-shadow:0 0 10px var(--neon-blue);
  animation:scan 3s linear infinite;
}
@keyframes scan{
  0%   { transform:translateY(-2px); }
  100% { transform:translateY(100vh); }
}

.points-box{
  display:inline-flex;
  align-items:center;
  gap:.5rem;
  background:rgba(255,42,109,.12);
  border:var(--border);
  border-radius:50px;
  padding:.6rem 1.2rem;
  font-size:.9rem;
  color:var(--neon-purple);
}
.points-value{
  font-size:1.8rem;
  font-weight:700;
  color:var(--neon-pink);
  text-shadow:0 0 5px var(--neon-pink);
}

/* ===== BONUS CARDS ===== */
.bonus-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(160px, 1fr));
  gap:1.2rem;
}
.bonus-card{
  background:var(--dark-card);
  border:var(--border);
  border-radius:12px;
  position:relative;
  overflow:hidden;
  transition:transform .3s ease, box-shadow .3s ease;
}
.bonus-card:hover{
  transform:translateY(-4px);
  box-shadow:0 10px 25px rgba(5, 217, 232, .25);
}
.bonus-card::before{              // neon corner
  content:"";
  position:absolute;
  top:0; left:0; right:0; bottom:0;
  border-radius:12px;
  padding:1px;
  background:linear-gradient(135deg, var(--neon-pink), var(--neon-blue));
  -webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite:xor;
  mask-composite:exclude;
  opacity:0;
  transition:opacity .3s ease;
}
.bonus-card:hover::before{ opacity:1; }

.bonus-icon{
  width:56px; height:56px;
  margin:1rem auto .8rem;
  border-radius:12px;
  background:linear-gradient(135deg, var(--neon-pink), var(--neon-blue));
  display:grid; place-items:center;
  font-size:1.6rem;
  color:#fff;
  box-shadow:0 0 12px rgba(255,42,109,.5);
}

.bonus-title{
  font-size:1rem;
  font-weight:600;
  color:var(--neon-purple);
  margin-bottom:.25rem;
}
.bonus-desc{
  font-size:.75rem;
  color:rgba(209, 215, 255, .7);
}

/* glowing badges */
.badge-hot{
  position:absolute;
  top:8px; right:8px;
  background:var(--neon-pink);
  color:#fff;
  padding:4px 10px;
  font-size:.65rem;
  font-weight:700;
  border-radius:50px;
  box-shadow:0 0 10px var(--neon-pink);
  animation:pulseHot 1.4s infinite;
}
@keyframes pulseHot{
  0%,100%{ transform:scale(1); opacity:1; }
  50%{ transform:scale(1.1); opacity:.8; }
}
.badge-soon{
  position:absolute;
  top:8px; right:8px;
  background:rgba(108, 117, 125,.6);
  color:#fff;
  padding:4px 10px;
  font-size:.65rem;
  border-radius:50px;
}

/* ===== FULL-SCREEN SPIN (slide neon) ===== */
.spin-fullscreen{
  position:fixed; inset:0;
  background:var(--dark-bg);
  border-top:2px solid var(--neon-blue);
  z-index:1050;
  display:flex; flex-direction:column;
  animation:slideInNeon .4s ease-out;
}
@keyframes slideInNeon{
  from{ transform:translateX(100%); }
  to{ transform:translateX(0); }
}
.spin-header{
  display:flex; align-items:center; justify-content:space-between;
  padding:.75rem 1rem;
  background:rgba(255,42,109,.08);
  border-bottom:var(--border);
}
.btn-retour{
  background:transparent; border:none;
  color:var(--neon-blue); font-size:1.3rem;
  transition:color .2s;
}
.btn-retour:hover{ color:var(--neon-purple); }

.spin-content{ flex:1; overflow-y:auto; padding:1rem; }

/* ===== MOBILE ===== */
@media (max-width:576px){
  .bonus-hero{ padding:2rem 1rem; }
  .bonus-grid{ grid-template-columns:1fr 1fr; gap:.8rem; }
  .bonus-icon{ width:48px; height:48px; font-size:1.3rem; }
  .bonus-title{ font-size:.9rem; }
  .spin-fullscreen{ border-radius:0; } /* plein écran */
}
</style>
<!-- ===== DASHBOARD USER – COMPLET ===== -->
<div class="ux-dashboard">
  <!-- Sidebar -->
  
      <%if current_user.admin?%>
          <%= render partial: "layouts/sidebar/admin" %>
      <%else%>
          <%= render partial: "layouts/sidebar/utilisateur" %>
      <%end%>

      <!-- Main -->
      <main class="ux-main">

          <%= render partial: "layouts/card_entete"%>

          <!-- Contenu -->
          <div class="ux-content">
            <!-- Contenu -->


              <% provide :title, "Centre de bonus" %>

              <% setting = SpinSetting.instance %>
              <% reward_amount = setting.goal_points.to_i * setting.point_value_in_francs.to_i %>
              <!-- HERO -->
            <div class="bonus-hero text-light">
              <h2 class="fw-bold">🎁 Espace Bonus</h2>
              <p class="text-white-50">Débloque des récompenses lumineuses</p>
              <%if  setting.enabled == true %>
              <div class="points-box">
                <span class="points-label">Points :</span>
                <span class="points-value"><%= current_user.points %>/<%= setting.goal_points %></span>
              </div>
              <!-- ⭐ Nouveau : récompense finale -->
              <div class="reward-box mt-2">
                <span class="reward-label">🎉 Récompense à gagner :</span>
                <span class="reward-value"><%= number_to_currency(reward_amount, unit: "F CFA", precision: 0) %></span>
              </div>
              <%end%>
            </div>

            <!-- GRILLE -->
            <div class="container py-4">
              <div class="bonus-grid">
                <!-- SPIN -->
                <div class="bonus-card" onclick="openBonusWithSlide(this, '<%= users_spin_index_path %>')">
                <span class="badge-hot">HOT</span>
                <div class="bonus-icon">🎡</div>
                <div class="text-center px-2 pb-3">
                  <div class="bonus-title">Roue de la chance</div>
                  <div class="bonus-desc">Tours restants : <%= current_user.spins_left %></div>
                    <div class="progress mx-auto mt-3" style="height: 6px; width: 100%;">
                      <div id="progressBar" class="progress-bar" role="progressbar"
                          style="width: <%= (current_user.points.to_f / SpinSetting.instance.goal_points * 100).to_i %>%;">
                      </div>
                    </div>
                </div>
              </div>

              
                <!-- AUTRES MISSIONS -->
                <div class="bonus-card opacity-75">
                  <span class="badge-soon">BIENTOT</span>
                  <div class="bonus-icon">👥</div>
                  <div class="text-center px-2 pb-3">
                    <div class="bonus-title">Parrainer</div>
                    <div class="bonus-desc">0 / 5 amis</div>
                  </div>
                </div>

                <div class="bonus-card opacity-75">
                  <span class="badge-soon">BIENTOT</span>
                  <div class="bonus-icon">📹</div>
                  <div class="text-center px-2 pb-3">
                    <div class="bonus-title">Vidéo</div>
                    <div class="bonus-desc">0 / 3 vidéos</div>
                  </div>
                </div>
              </div>
            </div>

            <!--FIN  Contenu -->
          </div>
      </main>
  </div>

<script>
  // app/javascript/bonus_slide.js
window.openBonusWithSlide = function (card, url) {
  // 1. Effet visuel sur la carte
  card.style.transition = 'transform .3s ease';
  card.style.transform = 'scale(0.95) rotate(1deg)';
  card.style.opacity = '.8';

  // 2. Après l'anim on change de page
  setTimeout(() => {
    window.location.href = url;
  }, 300);
};
</script>