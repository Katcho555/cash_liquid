<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Réseau de Parrainage</title>
  <script src="https://unpkg.com/vis-network@9.1.6/dist/vis-network.min.js"></script>
  <link href="https://unpkg.com/vis-network@9.1.6/styles/vis-network.min.css" rel="stylesheet">

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background: #f9fafb;
      padding: 40px;
    }

    h2 {
      text-align: center;
      color: #0d6efd;
      margin-bottom: 30px;
    }

    #network {
      width: 100%;
      height: 600px;
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .vis-network > div {
      border-radius: 16px;
    }
  </style>
</head>
<body>

  <h2>🌳 Réseau de Parrainage</h2>
  <div id="network"></div>

  <script>
    // Exemple de données simulées (tu les remplaceras par celles venant de Rails)
    const users = [
      { id: 1, label: "Admin", level: 0 },
      { id: 2, label: "Alice", parent: 1 },
      { id: 3, label: "David", parent: 1 },
      { id: 4, label: "Bob", parent: 2 },
      { id: 5, label: "Clara", parent: 2 },
      { id: 6, label: "Emma", parent: 3 },
    ];

    // Création des nœuds
    const nodes = new vis.DataSet(
      users.map(u => ({
        id: u.id,
        label: u.label,
        color: u.level === 0 ? "#0d6efd" : "#198754",
        font: { color: "#fff", size: 16 },
        shape: "circle",
        size: 30
      }))
    );

    // Création des liens (arêtes)
    const edges = new vis.DataSet(
      users.filter(u => u.parent).map(u => ({
        from: u.parent,
        to: u.id,
        arrows: "to",
        color: { color: "#999" }
      }))
    );

    // Configuration du graphe
    const container = document.getElementById("network");
    const data = { nodes, edges };
    const options = {
      layout: {
        hierarchical: {
          direction: "UD", // haut → bas
          sortMethod: "hubsize"
        }
      },
      nodes: {
        borderWidth: 2,
        shadow: true
      },
      edges: {
        smooth: true
      },
      interaction: {
        dragNodes: true,
        zoomView: true
      },
      physics: false
    };

    // Affichage
    const network = new vis.Network(container, data, options);

    // Événement : clic sur un utilisateur
    network.on("selectNode", params => {
      const nodeId = params.nodes[0];
      const user = users.find(u => u.id === nodeId);
      if (user) {
        alert(`👤 ${user.label}\nID: ${user.id}`);
      }
    });
  </script>

</body>
</html>
