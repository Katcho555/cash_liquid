
    <style>
      a{
        text-decoration: none;
      }
    .bg-gradient-primary {
    background: linear-gradient(135deg, #0d6efd, #0a58ca);
    }

    .action-card {
    border: 0;
    box-shadow: 0 .125rem .25rem rgba(0,0,0,.075);
    transition: transform .2s ease, box-shadow .2s ease;
    }

    .action-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
    }
    /* Cards solde et retraits */
    .balance-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        border-radius: 15px;
    }
    
    .withdrawal-card {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        border: none;
        border-radius: 15px;
    }
    
    /* Cards navigation */
    .nav-card {
        height: 150px;
        border-radius: 15px;
        overflow: hidden;
        position: relative;
        margin-bottom: 20px;
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        transition: transform 0.3s;
    }
    
    .nav-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 12px rgba(0,0,0,0.15);
    }
    
    .nav-card-recharge {
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                    url('https://images.unsplash.com/photo-1553729459-efe14ef6055d?w=400&h=300&fit=crop') center/cover;
    }
    
    .nav-card-retrait {
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                    url('https://images.unsplash.com/photo-1551650975-87deedd944c3?w=400&h=300&fit=crop') center/cover;
    }
    
    .nav-card-historique {
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                    url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=400&h=300&fit=crop') center/cover;
    }
    
    .nav-card-service {
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                    url('https://images.unsplash.com/photo-1556761175-b413da4baf72?w=400&h=300&fit=crop') center/cover;
    }
    
    .nav-card-btn {
        position: absolute;
        bottom: 15px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(255,255,255,0.9);
        border: none;
        padding: 8px 20px;
        border-radius: 20px;
        font-weight: 600;
        color: #333;
    }
</style>

<div class="dash-body">


<%= render partial: "layouts/header_admin"%>

    <!-- Main Content -->
    <div class="container my-4">

  <div class="row g-3 mb-4">

    <!-- SOLDE -->
    <div class="col-md-6">
      <div class="card shadow-sm border-0 bg-gradient-primary text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <small class="text-white-50">Solde disponible</small>
              <h2 class="fw-bold mt-1 mb-0">
                <% if current_user.admin? %>
                  <%= number_with_delimiter(@total_gain + User.first.balance) %>
                <% else %>
                  <%= number_with_delimiter(current_user.balance) %>
                <% end %>
                <span class="fs-6">FCFA</span>
              </h2>
            </div>
            <i class="bi bi-wallet2 fs-1 opacity-75"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- RETRAITS -->
    <div class="col-md-6">
      <div class="card shadow-sm border-0 bg-warning h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <small class="text-muted">Retraits validés</small>
              <h3 class="fw-semibold mt-1 mb-0 text-dark">
                <%= number_with_delimiter(
                      current_user.retraits.where(statut: 'Validé').sum(:montant)
                    ) %>
                <span class="fs-6">FCFA</span>
              </h3>
            </div>
            <i class="bi bi-cash-stack fs-1 text-success opacity-75"></i>
          </div>
        </div>
      </div>
    </div>

  </div>

    <div class="container my-4">
        <!-- Cards Navigation -->
        <div class="row">
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-recharge">
                    <a href="<%=products_path%>" class="nav-card-btn">
                        <i class="bi bi-plus-circle"></i> Recharger
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-retrait">
                    <a href="<%=new_retrait_path%>" class="nav-card-btn">
                        <i class="bi bi-arrow-down-circle"></i> Retrait
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-historique">
                    <a href="<%=my_subscriptions_subscriptions_path%>" class="nav-card-btn">
                        <i class="bi bi-clock-history"></i> Investissement
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-service">
                    <button class="nav-card-btn">
                        <i class="bi bi-headset"></i> Contact
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- SECTION AVANTAGES / PUBLICITÉ -->
<section class="container my-5">

  <div class="text-center mb-4">
    <h5 class="fw-bold">Pourquoi investir avec nous ?</h5>
    <p class="text-muted mb-0">
      Des opportunités fiables, transparentes et rentables
    </p>
  </div>

  <div class="row g-4">

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 text-center p-3">
        <i class="bi bi-shield-check text-success fs-1 mb-3"></i>
        <h6 class="fw-semibold">Investissement sécurisé</h6>
        <p class="text-muted small">
          Vos fonds sont gérés avec transparence et traçabilité.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 text-center p-3">
        <i class="bi bi-graph-up-arrow text-primary fs-1 mb-3"></i>
        <h6 class="fw-semibold">Rendements attractifs</h6>
        <p class="text-muted small">
          Profitez de revenus journaliers sur des projets réels.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 text-center p-3">
        <i class="bi bi-people-fill text-warning fs-1 mb-3"></i>
        <h6 class="fw-semibold">Parrainage rémunéré</h6>
        <p class="text-muted small">
          Gagnez des commissions grâce à votre réseau.
        </p>
      </div>
    </div>

  </div>
</section>

<section class="container my-5">
  <div class="card bg-dark text-white shadow-sm">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap">
      <div>
        <h5 class="mb-1">Nouvelle opportunité d’investissement disponible</h5>
        <small class="text-white-50">
          Profitez dès maintenant des rendements journaliers
        </small>
      </div>
      <a href="<%= products_path %>" class="btn btn-warning mt-3 mt-md-0">
        Voir les produits
      </a>
    </div>
  </div>
</section>



   <%= render partial: "layouts/footer_admin"%>

</div>