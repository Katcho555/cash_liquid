<!-- ===================== account my profile section start ====================== -->
<section class="bg-neutral-10 z-1">
    <div class="container">
        <div class="dashboard-item tw-pb-8 d-xl-flex tw-gap-6 w-100 tw-mt--193px">
            

             <%if current_user.admin?%>
                <%= render partial: "layouts/sidebar/admin" %>
            <%else%>
                <%= render partial: "layouts/sidebar/utilisateur" %>
            <%end%>

            <!-- ========================= my profile account tabe section start ======================== -->
<div class="flex-grow-1">

    <div class="bg-white tw-px-10 rounded-3 tw-py-8 w-100 tw-mb-6">
        <button type="button" class="dashboard-toggle-button text-base-two-600 tw-text-8 tw-mb-6 d-xl-none d-block tw-m-l-end">
            <i class="ph-bold ph-list"></i>
        </button>
        
        <%= render partial: "layouts/card_entete"%>
    </div>

    <div class="bg-white tw-px-5 tw-py-5 rounded-3 tw-mb-6 ">
        <h4 class="fw-normal text-dark-600">Statistiques</h4>
        <span class="border-neutral-200 border-bottom tw-border-dashed w-100 tw-mt-6 tw-mb-6"></span>

    <div class="row gy-4">
      <div class="col-md-4"> 
        <div class="card">
          <div class="card-content">
            <div class="card-body">
              <div class="media d-flex" style="justify-content: space-between;">
                <div class="align-self-center">
                  <i class="fas fa-users text-primary fa-2x float-left"></i>
                </div>
                <div class="media-body text-right">
                  <h3><%=@total_utilisateur_nombre%></h3>
                  <span>Utilisateurs inscrits</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4"> 
        <div class="card">
          <div class="card-content">
            <div class="card-body">
              <div class="media d-flex" style="justify-content: space-between;">
                <div class="align-self-center">
                  <i class="fas fa-users text-success fa-2x float-left"></i>
                </div>
                <div class="media-body text-right">
                  <h3><%= User.where(compte_status: 'true').count %></h3>
                  <span>Utilisateurs Actif</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4"> 
        <div class="card">
          <div class="card-content">
            <div class="card-body">
              <div class="media d-flex" style="justify-content: space-between;">
                <div class="align-self-center">
                  <i class="fas fa-users text-danger fa-2x float-left"></i>
                </div>
                <div class="media-body text-right">
                  <h3><%= User.where(compte_status: 'false').count %></h3>
                  <span>Utilisateurs Inactif</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <div class="card-content">
            <div class="card-body">
              <div class="media d-flex" style="justify-content: space-between;">
                <div class="align-self-center">
                  <i class="fas fa-wallet text-success fa-2x float-left"></i>
                </div>
                <div class="media-body text-right">
                  <h3><%=@balance_admin_reelle%></h3>
                  <span>Total Commission</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <div class="card-content">
            <div class="card-body">
              <div class="media d-flex" style="justify-content: space-between;">
                <div class="align-self-center">
                 <i class="fas fa-wallet text-success fa-2x float-left"></i>
                </div>
                <div class="media-body text-right">
                  <h3><%=@total_gain %></h3>
                  <span>Gain généré</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card">
          <div class="card-content">
            <div class="card-body">
              <div class="media d-flex" style="justify-content: space-between;">
                <div class="align-self-center">
                   <i class="fas fa-credit-card text-danger fa-2x float-left"></i>
                </div>
                <div class="media-body text-right">
                  <h3><%=@total_retraits_nets%></h3>
                  <span>Retrait total</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    </div>

    <div class="bg-white tw-px-8 tw-py-8 rounded-3 ">

        <h4 class="fw-normal text-dark-600">Inscriptions récentes</h4>
        <span class="border-neutral-200 border-bottom tw-border-dashed w-100 tw-mt-6 tw-mb-6"></span>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead >
                  <tr class="tw-mb-3">
                    <th scope="col" class="bg-base-two-10 fw-semibold tw-text-xl">
                        <span class="tw-px-6 tw-py-4">
                            utilisateur
                        </span>
                    </th>
                    <th scope="col" class="bg-base-two-10 fw-semibold tw-text-xl">
                        <span class="tw-px-6 tw-py-4">
                            Date Inscription
                        </span>
                    </th>
                    <th scope="col" class="bg-base-two-10 fw-semibold tw-text-xl">
                        <span class="tw-px-6 tw-py-4 text-center justify-content-center d-flex">
                            Status
                        </span>
                    </th>
                    <th scope="col" class="bg-base-two-10 fw-semibold tw-text-xl">
                        <span class="tw-px-6 tw-py-4">
                            Solde
                        </span>
                    </th>
                  </tr>
                </thead>
    
                <tbody>  
                    <% @total_utilisateur_liste.each_with_index do |user| %> 
                        <tr>
                            <th scope="row">
                                <div class="tw-px-6 tw-py-2">
                                    <span class="fw-semibold tw-text-4 text-dark-600 tw-mb-1 d-block"><%=user.nom%> <%=user.prenom%></span>  
                                    <span class="fw-medium tw-text-sm">
                                        <%=user.email%>
                                    </span>
                                </div>
                            </th>
            
                            <td>
                                <div class="tw-px-6 tw-py-2">
                                    <span class="fw-semibold tw-text-4 text-dark-600 tw-mb-1 d-block">
                                        <%= user.created_at.strftime("%d %B %Y") %>
                                    </span>
                                    <span class="fw-medium tw-text-sm">
                                        <%= user.created_at.strftime("%I:%M %p") %>
                                    </span>
                                </div>

                            </td>
            
                            <td>
                                <%if user.compte_status == true%>
                                    <button type="button" class="bg-primary-05 text-primary-600 tw-px-6 tw-py-205 rounded-pill fw-semibold tw-text-sm mx-auto justify-content-center d-flex">
                                        Actif
                                    </button>
                                <%else%>
                                    <button type="button" class="bg-danger-05 text-danger-600 tw-px-6 tw-py-205 rounded-pill fw-semibold tw-text-sm mx-auto justify-content-center d-flex">
                                        Inactif
                                    </button>
                                <%end%>
                            </td>
            
                            <td>
                                <div class="tw-px-6 tw-py-2">
                                    <span class="fw-semibold tw-text-4 text-dark-600 tw-mb-1 d-block"> <%=user.balance%> </span>
                                    <span class="fw-medium tw-text-sm">
                                        Fcfa
                                    </span>
                                </div>
                            </td>
                        </tr> 
                    <%end%> 
                </tbody>
            </table>
        </div>
        
        <ul class="d-flex align-items-center tw-gap-1 justify-content-center flex-wrap pt-5">
            <li>
                <a href="<%=dashboard_list_utilisateur_path%>" class="btn btn-primary">
                    Voir la liste complet
                </a>
            </li>
        </ul>

    </div>

 </div>
<!-- ========================= my profile account tabe section end ======================== -->

        </div>
    </div>
 </section>
