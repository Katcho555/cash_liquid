
<!-- ===== DASHBOARD USER – COMPLET ===== -->
<div class="ux-dashboard">
  <!-- Sidebar -->
  

     <%if current_user.admin?%>
        <%= render partial: "layouts/sidebar/admin" %>
    <%else%>
        <%= render partial: "layouts/sidebar/utilisateur" %>
    <%end%>

    <!-- Main -->
        <main class="ux-main">

            <%= render partial: "layouts/card_entete"%>

            <!-- Contenu -->
            <div class="ux-content p-3 p-lg-4">
              <!-- Contenu -->

              <!-- Cartes résumé : DESIGN CAPTIVANT -->
                <div class="bg-white rounded-3 card-margin">
                    <div class="row gy-4" style="align-items: center;">
                        <div class="col-lg-6">
                            <!-- app/views/shared/_balance_card.html.erb -->
                                <!-- app/views/shared/_balance_card.html.erb -->
                            <div class="ux-balance-card" data-theme="light">
                                <!-- Icône animée (portefeuille) -->
                                <div class="ux-wallet-icon"></div>

                                <!-- Solde cliquable -->
                                <div class="ux-balance-amount ux-clickable" data-bs-toggle="modal" data-bs-target="#uxGainModal">
                                    <% if current_user.admin? %>
                                    <%= number_with_delimiter(@total_gain + User.first.balance) %> <span class="ux-currency">FCFA</span>
                                    <% else %>
                                    <%= number_with_delimiter(current_user.balance) %> <span class="ux-currency">FCFA</span>
                                    <% end %>
                                </div>

                                <!-- Libellé -->
                                <div class="ux-balance-label">Solde disponible</div>

                                <!-- CTA discret -->
                                <a href="#" class="ux-balance-link" data-bs-toggle="modal" data-bs-target="#uxGainModal">Voir détails</a>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <div class="referral-card">
                                <p class="mb-3">Partagez ce code avec vos contacts pour gagner des récompenses à chaque nouvelle inscription</p>
                                <div class="referral-code" id="referralCode"><%= root_url %>inscription?ref=<%= current_user.referral_code %></div>
                                <p>Pour chaque filleul qui s'inscrit avec votre code, vous gagnez <span class="fw-bold">10%</span> de ses transactions</p>
                                
                                <div class="social-share">
                                    <button class="btn" title="Copier le code" id="copyBtn">
                                        <i class="fas fa-copy"></i>
                                    </button>
                                    <button class="btn" title="Partager sur WhatsApp">
                                        <i class="fab fa-whatsapp"></i>
                                    </button>
                                    <button class="btn" title="Partager sur Facebook">
                                        <i class="fab fa-facebook-f"></i>
                                    </button>
                                    <button class="btn" title="Partager par email">
                                        <i class="fas fa-envelope"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal « Comment gagner » -->
                <div class="modal fade" id="uxGainModal" tabindex="-1" aria-labelledby="uxGainModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="uxGainModalLabel">Comment gagner ?</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                        </div>
                        <div class="modal-body">
                            <ul class="ux-gain-list">
                            <li><i class="fa fa-share-nodes"></i> Parrainez → bonus par filleul</li>
                            <li><i class="fa fa-bag-shopping"></i> Ajoutez des produits → commissions</li>
                            <li><i class="fa fa-bolt"></i> Faites des micro-tâches → gains instantanés</li>
                            <li><i class="fa fa-gift"></i> Participez aux événements → cadeaux</li>
                            </ul>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                        </div>
                        </div>
                    </div>
                </div>
                
                <div class="row g-4 mb-4">
                  <div class="col-12 col-md-6">
                      <div class="ux-card-new ux-card-glow-green">
                      <div class="ux-card-icon-float"><i class="fas fa-users text-primary"></i></div>
                      <div class="ux-card-data">
                          <div class="ux-card-val" data-target=<%=@total_utilisateur_nombre%>><%=@total_utilisateur_nombre%></div>
                          <div class="ux-card-label">Utilisateurs inscrits</div>
                      </div>
                      </div>
                  </div>
                  <div class="col-12 col-md-6">
                      <div class="ux-card-new ux-card-glow-blue">
                      <div class="ux-card-icon-float"><i class="fas fa-users text-success"></i></div>
                      <div class="ux-card-data">
                        <%@user_actif =  User.where(compte_status: 'true').count %>
                          <div class="ux-card-val" data-target=<%=@user_actif%>><%=@user_actif%></div>
                          <div class="ux-card-label">Utilisateurs Actif</div>
                      </div>
                      </div>
                  </div>
                  <div class="col-12 col-md-6">
                      <div class="ux-card-new ux-card-glow-green">
                      <div class="ux-card-icon-float"><i class="fa fa-coins"></i></div>
                      <div class="ux-card-data">
                          <div class="ux-card-val" data-target=<%=@total_gain %>><%=@total_gain %> FCFA</div>
                          <div class="ux-card-label">Gains Générés</div>
                      </div>
                      </div>
                  </div>
                  <div class="col-12 col-md-6">
                      <div class="ux-card-new ux-card-glow-blue">
                      <div class="ux-card-icon-float"><i class="fas fa-wallet text-success"></i></div>
                      <div class="ux-card-data">
                          <div class="ux-card-val" data-target=<%=@balance_admin_reelle%>><%=@balance_admin_reelle%></div>
                          <div class="ux-card-label">Total commission</div>
                      </div>
                      </div>
                  </div>
                  <div class="col-12 col-md-6">
                      <div class="ux-card-new ux-card-glow-orange">
                      <div class="ux-card-icon-float"><i class="fa fa-bag-shopping"></i></div>
                      <div class="ux-card-data">
                          <div class="ux-card-val" data-target="0">0</div>
                          <div class="ux-card-label">Produits</div>
                      </div>
                      </div>
                  </div>
                  <div class="col-12 col-md-6">
                      <div class="ux-card-new ux-card-glow-purple">
                      <div class="ux-card-icon-float"><i class="fa fa-list-check"></i></div>
                      <div class="ux-card-data">
                          <div class="ux-card-val" data-target="0">0</div>
                          <div class="ux-card-label">Tâches</div>
                      </div>
                      </div>
                  </div>
                  <div class="col-12 col-md-6">
                      <div class="ux-card-new ux-card-glow-orange">
                      <div class="ux-card-icon-float"><i class="fas fa-users text-danger"></i></div>
                      <div class="ux-card-data">
                        <%@user_inactif = User.where(compte_status: 'false').count %>
                          <div class="ux-card-val" data-target=<%=@user_inactif%>><%=@user_inactif%></div>
                          <div class="ux-card-label">Utilisateur inactif</div>
                      </div>
                      </div>
                  </div>
                  <div class="col-12 col-md-6">
                      <div class="ux-card-new ux-card-glow-purple">
                      <div class="ux-card-icon-float"><i class="fas fa-credit-card text-danger"></i></div>
                      <div class="ux-card-data">
                          <div class="ux-card-val" data-target=<%=@total_retraits_nets%>><%=@total_retraits_nets%></div>
                          <div class="ux-card-label">Retrait total</div>
                      </div>
                      </div>
                  </div>
                </div>

                <div class="bg-white tw-px-8 tw-py-8 rounded-3 mb-5">
                <h4 class="fw-normal text-dark-600">Inscriptions récentes</h4>
                <span class="border-neutral-200 border-bottom tw-border-dashed w-100 tw-mt-6 tw-mb-6"></span>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead >
                            <tr class="tw-mb-3">
                            <th scope="col" class="bg-base-two-10 fw-semibold tw-text-xl">
                                <span class="tw-px-6 tw-py-4">
                                    utilisateur
                                </span>
                            </th>
                            <th scope="col" class="bg-base-two-10 fw-semibold tw-text-xl">
                                <span class="tw-px-6 tw-py-4">
                                    Date Inscription
                                </span>
                            </th>
                            <th scope="col" class="bg-base-two-10 fw-semibold tw-text-xl">
                                <span class="tw-px-6 tw-py-4 text-center justify-content-center d-flex">
                                    Status
                                </span>
                            </th>
                            <th scope="col" class="bg-base-two-10 fw-semibold tw-text-xl">
                                <span class="tw-px-6 tw-py-4">
                                    Solde
                                </span>
                            </th>
                            </tr>
                        </thead>

                        <tbody>  
                            <% @total_utilisateur_liste.each_with_index do |user| %> 
                                <tr>
                                    <th scope="row">
                                        <div class="tw-px-6 tw-py-2">
                                            <span class="fw-semibold tw-text-4 text-dark-600 tw-mb-1 d-block"><%=user.nom%> <%=user.prenom%></span>  
                                            <span class="fw-medium tw-text-sm">
                                                <%=user.email%>
                                            </span>
                                        </div>
                                    </th>
                    
                                    <td>
                                        <div class="tw-px-6 tw-py-2">
                                            <span class="fw-semibold tw-text-4 text-dark-600 tw-mb-1 d-block">
                                                <%= user.created_at.strftime("%d %B %Y") %>
                                            </span>
                                            <span class="fw-medium tw-text-sm">
                                                <%= user.created_at.strftime("%I:%M %p") %>
                                            </span>
                                        </div>

                                    </td>
                    
                                    <td>
                                        <%if user.compte_status == true%>
                                            <button type="button" class="bg-primary-05 text-primary-600 tw-px-6 tw-py-205 rounded-pill fw-semibold tw-text-sm mx-auto justify-content-center d-flex">
                                                Actif
                                            </button>
                                        <%else%>
                                            <button type="button" class="bg-danger-05 text-danger-600 tw-px-6 tw-py-205 rounded-pill fw-semibold tw-text-sm mx-auto justify-content-center d-flex">
                                                Inactif
                                            </button>
                                        <%end%>
                                    </td>
                    
                                    <td>
                                        <div class="tw-px-6 tw-py-2">
                                            <span class="fw-semibold tw-text-4 text-dark-600 tw-mb-1 d-block"> <%=user.balance%> </span>
                                            <span class="fw-medium tw-text-sm">
                                                Fcfa
                                            </span>
                                        </div>
                                    </td>
                                </tr> 
                            <%end%> 
                        </tbody>
                    </table>
                </div>
                <ul class="d-flex align-items-center tw-gap-1 justify-content-center flex-wrap pt-5">
                    <li>
                        <a href="<%=dashboard_list_utilisateur_path%>" class="btn btn-primary">
                            Voir la liste complet
                        </a>
                    </li>
                </ul>
                </div>

            

              <!--FIN  Contenu -->
            </div>
        </main>
    </div>

    <!-- Popup Bienvenue + Guirlande -->
    <div class="ux-welcome-modal" id="uxWelcomeModal">
    <div class="ux-confetti"></div>
    <div class="ux-welcome-content">
        <h3 class="mb-3">🎉 Bienvenue dans votre espace !</h3>
        <p class="mb-4">
        Vous êtes à un clic de transformer votre temps en argent. <br>
        Commencez dès maintenant : parrainez, vendez, effectuez des tâches.
        </p>
        <button class="btn btn-gradient px-4 py-2" id="uxCloseWelcome">
        C'est parti !
        </button>
    </div>
    </div>


  <%#= javascript_include_tag 'dashboard' %>