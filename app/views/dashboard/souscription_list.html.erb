<!-- ===== DASHBOARD USER – COMPLET ===== -->
<div class="ux-dashboard">
  <!-- Sidebar -->
  

     <%if current_user.admin?%>
        <%= render partial: "layouts/sidebar/admin" %>
    <%else%>
        <%= render partial: "layouts/sidebar/utilisateur" %>
    <%end%>

    <!-- Main -->
        <main class="ux-main">

            <%= render partial: "layouts/card_entete"%>

            <!-- Contenu -->
            <div class="ux-content p-3 p-lg-4">
              <!-- Contenu -->
                <div class="row">
                    <div class="col-md-12">

                        <div class="bg-white tw-px-8 tw-py-8 rounded-3 tw-mb-6">
                            <h4 class="fw-normal text-dark-600">Gestion des Souscriptions</h4>
                            <div>
                                <form action="#" class="">
                                    <input type="text" id="searchInput" class="form-control mb-3 tw-px-3 tw-py-3 bg-neutral-10 rounded-3 border-0 max-w-500-px w-100 fw-normal tw-text-lg text-dark-600" placeholder="Rechercher un utilisateur, email, parrain...">
                                </form>
                            </div>
                        </div>

                        <div class="bg-white tw-px-8 tw-py-8 rounded-3">

                            <h5 class="fw-normal text-dark-600">Toutes les souscriptions</h5>
                            <span class="border-neutral-200 border-bottom tw-border-dashed w-100 tw-mt-6 tw-mb-6"></span>
                                <% if flash[:success] %>
                                    <div class="alert alert-success"><%= flash[:success] %></div>
                                <% elsif flash[:error] %>
                                    <div class="alert alert-danger"><%= flash[:error] %></div>
                                <% end %>

                            <div class="table-responsive">
                                <table class="table table-striped table-hover table-bordered" id="usersTable">
                                    <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Utilisateur</th>
                                        <th>Montant</th>
                                        <th>Statut</th>
                                        <th>Méthode de paiement</th>
                                        <th>Référence</th>
                                        <th>Date paiement</th>
                                        <th>Créé le</th>
                                        <th>Mis à jour le</th>
                                        <th>Vérification</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                        <% @subscriptions.each do |subscription| %>
                                            <tr>
                                            <td><%= subscription.id %></td>
                                            <td>
                                                <% if subscription.user %>
                                                <%= subscription.user.prenom %> <%= subscription.user.nom %> (<%= subscription.user.email %>)
                                                <% else %>
                                                Utilisateur supprimé
                                                <% end %>
                                            </td>
                                            <td><%= number_to_currency(subscription.amount || 0, unit: "XOF", delimiter: " ", format: "%n %u") %></td>
                                            <td>
                                                <% case subscription.status %>
                                                <% when "payé" %>
                                                <span class="badge bg-success">Payé</span>
                                                <% when "en_attente" %>
                                                <span class="badge bg-warning text-dark">En attente</span>
                                                <% else %>
                                                <span class="badge bg-secondary"><%= subscription.status %></span>
                                                <% end %>
                                            </td>
                                            <td><%= subscription.payment_method.presence || "—" %></td>
                                            <td><%= subscription.reference.presence || "—" %></td>
                                            <td><%= subscription.paid_at ? l(subscription.paid_at, format: :short) : "—" %></td>
                                            <td><%= l(subscription.created_at, format: :short) %></td>
                                            <td><%= l(subscription.updated_at, format: :short) %></td>
                                            <td>
                                                <% if subscription.status == "en_attente" %>
                                                    <div class="dropdown">
                                                        <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" id="actionsDropdown<%= subscription.id %>" data-bs-toggle="dropdown" aria-expanded="false">
                                                        Actions
                                                        </button>
                                                        <ul class="dropdown-menu" aria-labelledby="actionsDropdown<%= subscription.id %>">
                                                        
                                                        

                                                        <!-- Forcer la validation -->
                                                        <li>
                                                            <button 
                                                                class="dropdown-item" 
                                                                data-bs-toggle="modal" 
                                                                data-bs-target="#forceValidateModal" 
                                                                data-id="<%= subscription.id %>">
                                                            Forcer la validation
                                                            </button>
                                                        </li>

                                                        <!-- Supprimer la souscription -->
                                                        <li>
                                                            <%= button_to "Supprimer",
                                                                dashboard_delete_subscription_path(subscription.id),
                                                                method: :delete,
                                                                data: { confirm: "Êtes-vous sûr de vouloir supprimer cette souscription ?" },
                                                                class: "dropdown-item text-danger" %>
                                                        </li>

                                                        </ul>
                                                    </div>
                                                <%else%>
                                                OK
                                                <%end%>
                                            </td>



                                            </tr>
                                        <% end %>
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex justify-content-center mt-3">
                                <%= paginate @subscriptions %>
                            </div>

                        </div>
                    </div>
                </div>
         
            <!--FIN  Contenu -->
        </div>
    </main>
</div>


<div class="modal fade" id="forceValidateModal" tabindex="-1" aria-labelledby="forceValidateModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header bg-warning text-dark">
        <h5 class="modal-title" id="forceValidateModalLabel">Forcer la validation du paiement</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="forceValidateForm" method="POST">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Mot de passe administrateur</label>
            <input type="password" name="admin_password" class="form-control" required>
          </div>
          <p class="text-muted">
            ⚠️ Cette action activera le compte de l’utilisateur même si le paiement Moneroo n’a pas encore été confirmé.
          </p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
          <button type="submit" class="btn btn-warning">Valider manuellement</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const modal = document.getElementById("forceValidateModal");
  const form = document.getElementById("forceValidateForm");

  modal.addEventListener("show.bs.modal", (event) => {
    const button = event.relatedTarget;
    const subscriptionId = button.getAttribute("data-id");
    form.action = `/dashboard/force_validate/${subscriptionId}`;
  });
});
</script>


<script>
  document.addEventListener("turbo:load", function() {
    const input = document.getElementById("searchInput");
    const table = document.getElementById("usersTable");
    input.addEventListener("keyup", function() {
      const filter = input.value.toLowerCase();
      const rows = table.getElementsByTagName("tr");

      for(let i = 1; i < rows.length; i++) { // Skip header row
        const row = rows[i];
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? "" : "none";
      }
    });
  });
</script>

