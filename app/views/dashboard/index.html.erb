
    <style>
        /* Cards solde et retraits */
        .balance-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 15px;
        }
        
        .withdrawal-card {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            border: none;
            border-radius: 15px;
        }
        
        /* Cards navigation */
        .nav-card {
            height: 150px;
            border-radius: 15px;
            overflow: hidden;
            position: relative;
            margin-bottom: 20px;
            border: none;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            transition: transform 0.3s;
        }
        
        .nav-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 12px rgba(0,0,0,0.15);
        }
        
        .nav-card-recharge {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                        url('https://images.unsplash.com/photo-1553729459-efe14ef6055d?w=400&h=300&fit=crop') center/cover;
        }
        
        .nav-card-retrait {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                        url('https://images.unsplash.com/photo-1551650975-87deedd944c3?w=400&h=300&fit=crop') center/cover;
        }
        
        .nav-card-historique {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                        url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=400&h=300&fit=crop') center/cover;
        }
        
        .nav-card-service {
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                        url('https://images.unsplash.com/photo-1556761175-b413da4baf72?w=400&h=300&fit=crop') center/cover;
        }
        
        .nav-card-btn {
            position: absolute;
            bottom: 15px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(255,255,255,0.9);
            border: none;
            padding: 8px 20px;
            border-radius: 20px;
            font-weight: 600;
            color: #333;
        }
    </style>

<div class="dash-body">


<%= render partial: "layouts/header_admin"%>

    <!-- Main Content -->
    <div class="container my-4">
        <!-- Cards Solde et Retraits -->
        <div class="row mb-4">
            <div class="col-md-6 col-6 mb-3">
                <div class="card balance-card">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-wallet2"></i> Mon Solde</h5>
                        <h2 class="mb-0">
                          <% if current_user.admin? %>
                            <%= number_with_delimiter(@total_gain + User.first.balance) %> <span class="ux-currency">FCFA</span>
                          <% else %>
                            <%= number_with_delimiter(current_user.balance) %> <%=@total_retraits_utilisateur%>
                          <% end %>
                        </h2>
                        <small>Disponible</small>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-6 mb-3">
                <div class="card withdrawal-card">
                    <div class="card-body">
                        <h5 class="card-title"><i class="bi bi-cash-stack"></i> Mes Retraits</h5>
                        <h2 class="mb-0">
                          <%= current_user.retraits.where(statut: 'Validé').sum(:montant) %> <span class="ux-currency">FCFA</span>
                        </h2>
                        <small>retrait effectué</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Séparation -->
        <hr class="my-4">

        <!-- Cards Navigation -->
        <div class="row">
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-recharge">
                    <a href="<%=products_path%>" class="nav-card-btn">
                        <i class="bi bi-plus-circle"></i> Recharger
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-retrait">
                    <a href="<%=new_retrait_path%>" class="nav-card-btn">
                        <i class="bi bi-arrow-down-circle"></i> Retrait
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-historique">
                    <a href="<%=my_subscriptions_subscriptions_path%>" class="nav-card-btn">
                        <i class="bi bi-clock-history"></i> Historique
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-service">
                    <button class="nav-card-btn">
                        <i class="bi bi-headset"></i> Contact
                    </button>
                </div>
            </div>
        </div>
    </div>

   <%= render partial: "layouts/footer_admin"%>

</div>