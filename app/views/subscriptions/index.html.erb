 <div class="dash-admin">
    
    <%=render "layouts/back"%>

      <% if @product %>
        <div class="investment-wrapper">
          <div class="invest-card">
            <header class="invest-header">
              <h1><%= @product.name %></h1>
              <span class="tag">Investissement Pétrole - <%= @product.contract_days %> jours</span>
            </header>

            <div class="invest-body">
              <div class="row-data">
                <span class="label">Montant de l'investissement</span>
                <span class="value"><%= number_with_delimiter @product.purchase_price %> <small>FCFA</small></span>
              </div>
              <div class="row-data">
                <span class="label">Revenu journalier estimé</span>
                <span class="value"><%= number_with_delimiter @product.daily_revenue %> <small>FCFA</small></span>
              </div>
              <div class="row-data">
                <span class="label">Retour total estimé</span>
                <span class="value"><%= number_with_delimiter @product.total_gain %> <small>FCFA</small></span>
              </div>
              <div class="row-data">
                <span class="label">Durée du contrat</span>
                <span class="value"><%= @product.contract_days %> <small>jours</small></span>
              </div>
            </div>

            <%= form_with url: subscriptions_path, method: :post, html: { id: "subscription-form" }, data: { turbo: false } do %>
              <%= hidden_field_tag :product_id, @product.id %>
              <button type="submit" class="invest-btn" id="pay-button">
                <i class="fa-solid fa-lock"></i> J'investis maintenant
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
      <style>
        /* Background subtil avec dégradé léger */
        .investment-wrapper {
          min-height: 100vh;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 2rem;
          background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
          background-attachment: fixed;
        }

        .invest-card {
          width: 100%;
          max-width: 480px;
          background: rgba(255, 255, 255, 0.95);
          backdrop-filter: blur(10px);
          border: 1px solid rgba(255, 255, 255, 0.2);
          border-radius: 24px;
          padding: 2.5rem;
          box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
          transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .invest-card:hover {
          transform: translateY(-5px);
          box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        }

        .invest-header {
          text-align: center;
          margin-bottom: 2.5rem;
        }

        .invest-header h1 {
          font-size: 1.8rem;
          font-weight: 600;
          color: #1a1a1a;
          margin-bottom: 0.5rem;
          letter-spacing: -0.5px;
        }

        .tag {
          display: inline-block;
          font-size: 0.8rem;
          color: #6b7280;
          background: rgba(107, 114, 128, 0.1);
          border-radius: 16px;
          padding: 0.4rem 1rem;
          font-weight: 500;
        }

        .invest-body {
          margin-bottom: 2rem;
        }

        .row-data {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding: 1rem 0;
          border-bottom: 1px solid rgba(0, 0, 0, 0.05);
          transition: background-color 0.2s ease;
        }

        .row-data:hover {
          background-color: rgba(107, 114, 128, 0.02);
          border-radius: 8px;
          padding-left: 0.5rem;
          padding-right: 0.5rem;
        }

        .row-data:last-child {
          border-bottom: none;
        }

        .label {
          font-size: 0.9rem;
          color: #6b7280;
          font-weight: 400;
        }

        .value {
          font-size: 1rem;
          font-weight: 600;
          color: #111827;
        }

        .value small {
          font-weight: 400;
          color: #9ca3af;
          font-size: 0.85rem;
          margin-left: 0.2rem;
        }

        .invest-btn {
          width: 100%;
          border: none;
          border-radius: 16px;
          padding: 1rem;
          font-size: 1.05rem;
          font-weight: 500;
          color: #fff;
          background: linear-gradient(90deg, #4f46e5 0%, #7c3aed 100%);
          cursor: pointer;
          transition: all 0.3s ease;
          position: relative;
          overflow: hidden;
        }

        .invest-btn::before {
          content: '';
          position: absolute;
          top: 0;
          left: -100%;
          width: 100%;
          height: 100%;
          background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
          transition: left 0.5s;
        }

        .invest-btn:hover::before {
          left: 100%;
        }

        .invest-btn:hover {
          transform: translateY(-2px);
          box-shadow: 0 10px 25px rgba(124, 58, 237, 0.3);
        }

        .invest-btn:active {
          transform: translateY(0);
        }

        .invest-btn i {
          margin-right: 0.5rem;
          font-size: 0.9rem;
        }

        /* Responsive adjustments */
        @media (max-width: 640px) {
          .investment-wrapper {
            padding: 1rem;
          }
          
          .invest-card {
            padding: 2rem 1.5rem;
            border-radius: 20px;
          }
          
          .invest-header h1 {
            font-size: 1.5rem;
          }
          
          .row-data {
            padding: 0.8rem 0;
          }
        }

        /* Animation d'entrée */
        @keyframes fadeInUp {
          from {
            opacity: 0;
            transform: translateY(30px);
          }
          to {
            opacity: 1;
            transform: translateY(0);
          }
        }

        .invest-card {
          animation: fadeInUp 0.6s ease-out;
        }
      </style>

    <%= render partial: "layouts/footer_admin"%>
  </div> 