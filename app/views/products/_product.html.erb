<div id="<%= dom_id product %>">
  <p>
    <strong>Name:</strong>
    <%= product.name %>
  </p>

  <p>
    <strong>Purchase price:</strong>
    <%= product.purchase_price %>
  </p>

  <p>
    <strong>Daily revenue:</strong>
    <%= product.daily_revenue %>
  </p>

  <p>
    <strong>Total gain:</strong>
    <%= product.total_gain %>
  </p>

  <p>
    <strong>Contract days:</strong>
    <%= product.contract_days %>
  </p>

  <p>
    <strong>Description:</strong>
    <%= product.description %>
  </p>

  <p>
    <strong>Image:</strong>
    <%= product.image %>
  </p>

</div>
