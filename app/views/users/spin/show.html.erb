<%# app/views/users/spins/show.html.erb %>
<%= turbo_frame_tag "spin_full" do %>
  <div class="spin-fullscreen">
    <!-- ENTÊTE MOBILE -->
    <div class="spin-header">
      <%= link_to user_bonus_dashboard_path, data: { turbo_action: "replace" }, class:"btn btn-retour" do %>
        <i class="fa fa-arrow-left"></i> Retour
      <% end %>
      <h6 class="m-0">Tourner la roue</h6>
      <div></div>
    </div>

    <!-- ESPACE ROUE -->
    <div class="spin-content">
      <%= render 'users/shared/spin_box' %>
    </div>
  </div>

  <style>
  .spin-fullscreen{
    position:fixed; inset:0; background:#fff; z-index:1030;
    display:flex; flex-direction:column;
    animation:slideIn .3s ease-out;
  }
  .spin-header{
    display:flex; align-items:center; justify-content:space-between;
    padding:.75rem 1rem; border-bottom:1px solid #e9ecef;
    background:#f8f9fa;
  }
  .btn-retour{
    background:none; border:none; font-size:1.2rem; color:#495057;
  }
  .spin-content{ flex:1; overflow-y:auto; padding:1rem; }

  @keyframes slideIn{
    from{ transform:translateX(100%); }
    to{ transform:translateX(0); }
  }

  @media (min-width:768px){
    .spin-fullscreen{ max-width:420px; margin:0 auto; border-radius:1rem; }
  }
  </style>
<% end %>