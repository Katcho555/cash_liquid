<div class="dash-body">


<%= render partial: "layouts/header_admin"%>

    <!-- Main Content -->
    <div class="container my-4">

  <div class="row g-3 mb-4">

    <!-- SOLDE -->
    <div class="col-md-6">
      <div class="card shadow-sm border-0 bg-gradient-primary text-white h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <small class="text-white-50">Solde disponible</small>
              <h2 class="fw-bold mt-1 mb-0">
                <% if current_user.admin? %>
                  <%= number_with_delimiter(@total_gain + User.first.balance) %>
                <% else %>
                  <%= number_with_delimiter(current_user.balance) %>
                <% end %>
                <span class="fs-6">FCFA</span>
              </h2>
            </div>
            <i class="bi bi-wallet2 fs-1 opacity-75"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- RETRAITS -->
    <div class="col-md-6">
      <div class="card shadow-sm border-0 bg-warning h-100">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <small class="text-muted">Retraits validés</small>
              <h3 class="fw-semibold mt-1 mb-0 text-dark">
                <%= number_with_delimiter(
                      current_user.retraits.where(statut: 'Validé').sum(:montant)
                    ) %>
                <span class="fs-6">FCFA</span>
              </h3>
            </div>
            <i class="bi bi-cash-stack fs-1 text-success opacity-75"></i>
          </div>
        </div>
      </div>
    </div>

  </div>

    <div class="container my-4">
        <!-- Cards Navigation -->
        <div class="row">
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-recharge">
                    <a href="<%=products_path%>" class="nav-card-btn">
                        <i class="bi bi-plus-circle"></i> Recharger
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-retrait">
                    <a href="<%=new_retrait_path%>" class="nav-card-btn">
                        <i class="bi bi-arrow-down-circle"></i> Retrait
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-historique">
                    <a href="<%=my_subscriptions_subscriptions_path%>" class="nav-card-btn">
                        <i class="bi bi-clock-history"></i> Investissement
                    </a>
                </div>
            </div>
            <div class="col-6 col-md-3 mb-3">
                <div class="card nav-card nav-card-service">
                    <button class="nav-card-btn" data-bs-toggle="modal" data-bs-target="#contactModal">
                      <i class="bi bi-headset"></i>
                      <span>Contact</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- SECTION AVANTAGES / PUBLICITÉ -->
<section class="container my-5">

  <div class="text-center mb-4">
    <h5 class="fw-bold">Pourquoi investir avec nous ?</h5>
    <p class="text-muted mb-0">
      Des opportunités fiables, transparentes et rentables
    </p>
  </div>

  <div class="row g-4">

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 text-center p-3">
        <i class="bi bi-shield-check text-success fs-1 mb-3"></i>
        <h6 class="fw-semibold">Investissement sécurisé</h6>
        <p class="text-muted small">
          Vos fonds sont gérés avec transparence et traçabilité.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 text-center p-3">
        <i class="bi bi-graph-up-arrow text-primary fs-1 mb-3"></i>
        <h6 class="fw-semibold">Rendements attractifs</h6>
        <p class="text-muted small">
          Profitez de revenus journaliers sur des projets réels.
        </p>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 shadow-sm border-0 text-center p-3">
        <i class="bi bi-people-fill text-warning fs-1 mb-3"></i>
        <h6 class="fw-semibold">Parrainage rémunéré</h6>
        <p class="text-muted small">
          Gagnez des commissions grâce à votre réseau.
        </p>
      </div>
    </div>

  </div>
</section>

<section class="container my-5">
  <div class="card bg-dark text-white shadow-sm">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap">
      <div>
        <h5 class="mb-1">Nouvelle opportunité d’investissement disponible</h5>
        <small class="text-white-50">
          Profitez dès maintenant des rendements journaliers
        </small>
      </div>
      <a href="#" class="btn btn-warning mt-3 mt-md-0" data-bs-toggle="modal" data-bs-target="#cguModal">
        Conditions d’utilisation
      </a>
    </div>
  </div>
</section>

<style>
  .mission-card {
    border-radius: 14px;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .mission-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,.1);
  }

</style>

<div class="container my-5">
  <h4 class="fw-bold mb-3">
    🎯 Missions de bonus
  </h4>

 <% if @bonus_missions.any? %>
  <div class="row g-3">
    <% @bonus_missions.each do |mission| %>
      <% campaign = mission.bonus_campaign %>
      <% percent = [(mission.progress.to_f / campaign.threshold) * 100, 100].min %>

      <div class="col-md-4">
        <div class="card mission-card shadow-sm">
          <div class="card-body">
            <h6 class="fw-bold mb-2"><%= campaign.name %></h6>
            <p class="small text-muted mb-2">
              Parrainer <strong><%= campaign.threshold %></strong> filleuls actifs
            </p>

            <div class="progress mb-2" style="height: 8px;">
              <div class="progress-bar bg-success" style="width: <%= percent %>%"></div>
            </div>

            <small class="text-muted"><%= mission.progress %> / <%= campaign.threshold %> filleuls</small>

            <div class="mt-3 d-flex justify-content-between align-items-center">
              <span class="badge bg-primary">🎁 <%= number_with_delimiter(campaign.reward_amount) %> FCFA</span>

              <% if mission.locked %>
                 <% if mission.ready_to_claim? %>
                  <%= button_to "Obtenir ma récompense",
                    claim_reward_bonus_mission_path(mission),
                    method: :post,
                    class: "btn btn-success mt-2",
                    data: { turbo: false } %>
                <% elsif mission.rewarded? %>
                  <span class="badge bg-primary mt-2">Récompense obtenue 🎉</span>
                <% else %>
                  <span class="badge bg-secondary mt-2">En cours</span>
                <% end %>
              <% else %>
                <span class="text-secondary small">Nouvelle mission</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
    <!-- Aucun mission -->
    <div class="alert alert-light text-center py-5">
      <i class="bi bi-emoji-neutral fs-1 text-muted"></i>
      <p class="mt-3 mb-0 text-muted">
        Aucune mission de bonus disponible aujourd’hui
      </p>
    </div>
  <% end %>
</div>



   <%= render partial: "layouts/footer_admin"%>

</div>

