<style>
    /* Design 2 - Moderne avec Icône */
        .vip-badge-2 {
            background: linear-gradient(135deg, #2c3e50, #4a69bd);
            color: white;
            border-radius: 15px;
            font-size: 22px;
            font-weight: bold;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            display: flex;
            align-items: center;
            gap: 15px;
            position: relative;
            overflow: hidden;
            text-align: center;
            min-width: 250px;
            justify-content: center;
            margin-bottom: 10px;
        }
        
        .vip-badge-2::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #ffd700, #ffed4e, #ffd700);
            bottom: 0;
            left: 0;
        }
        
        .vip-badge-2 .crown-icon {
            font-size: 28px;
            color: #ffd700;
            animation: bounce 2s infinite;
        }
</style>
<div class="dashboard-slidebar tw-w-306-px bg-white tw-rounded-xl">
                <div class="tw-pt-12 tw-px-12 position-relative">
                    <a href="<%=edit_user_registration_path%>" type="button" class="tw-text-7 text-dark-600 position-absolute tw-block-start-22-px tw-end-22-px">
                        <i class="ph ph-pencil-simple-line"></i>
                    </a>
                    <button type="button" class="dashboard-close-button tw-text-xl tw-w-8 tw-h-8 border-neutral-200 rounded-circle hover-bg-base-two-600 hover-text-white tw-duration-500 d-flex align-items-center justify-content-center position-absolute z-1 tw-block-start-0 tw-mt-5 tw-start-24-px d-xl-none d-block">
                        <i class="ph-bold ph-x"></i>
                    </button>
                    <div class="position-relative tw-mb-8">

                        <div class="avatar-upload">
                            <div class="avatar-edit tw-end-8 tw-block-end-6">
                                    <input type='file' id="imageUpload" accept=".png, .jpg, .jpeg">
                                <label for="imageUpload" class="w-12 h-12 bg-base-two-600 rounded-circle tw-text-6 text-white d-flex align-items-center justify-content-center ">
                                    <i class="ph ph-camera"></i>
                                </label>
                            </div>
                            <div class="avatar-preview border-base-two-600 border rounded-circle tw-px-2 tw-py-2">
                                <div id="imagePreview" style="background-image: url('<%= asset_path("logo/logo2.png") %>');">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="text-center justify-content-center">
                        <h4 class="fw-normal text-dark-600 tw-mb-2">
                            <%=current_user.nom%> <%=current_user.prenom%>
                        </h4>
                        <span class="fw-normal tw-text-4 text-dark-500 ">
                            <%if current_user.compte_status == true%>
                            <span class="text-success">Compte Actif</span>
                            <%else%>
                            <span class="text-danger">Compte Inactif</span>
                            <%end%>
                        </span>
                    </div>
                </div>
                <div class="tw-px-6 tw-pb-6">
                    <span class="border-bottom-neutral-05 w-100 tw-mb-8 tw-mt-8"></span>
                    <div class="vip-badge-2 text-center">
                        <span class="crown-icon">👑</span>
                        <%= current_user.current_vip %>
                    </div>
                    <ul class="header-nav-menu__item">

                        <li class="header-nav-submenu__item tw-mb-4 activePage">
                            <a href="<%=dashboard_index_path%>" class="header-nav-submenu__link fw-normal tw-text-lg text-dark-600 d-flex align-items-center tw-gap-2 hover-text-white bg-neutral-10 tw-px-3 tw-py-3 rounded-3 hover-bg-base-two-600 tw-duration-400">
                                <span class="tw-text-6">
                                    <i class="ph ph-house"></i>
                                </span>
                                Dashboard
                            </a>
                        </li>

                        <li class="header-nav-submenu__item tw-mb-4 ">
                            <a href="<%=dashboard_list_utilisateur_path%>" class="header-nav-submenu__link fw-normal tw-text-lg text-dark-600 d-flex align-items-center tw-gap-2 hover-text-white bg-neutral-10 tw-px-3 tw-py-3 rounded-3 hover-bg-base-two-600 tw-duration-400">
                                <span class="tw-text-6">
                                    <i class="ph ph-arrows-left-right"></i>
                                </span>
                               Parrainage
                            </a>
                        </li>

                        <li class="header-nav-submenu__item tw-mb-4 ">
                            <a href="<%=retraits_path%>" class="header-nav-submenu__link fw-normal tw-text-lg text-dark-600 d-flex align-items-center tw-gap-2 hover-text-white bg-neutral-10 tw-px-3 tw-py-3 rounded-3 hover-bg-base-two-600 tw-duration-400">
                                <span class="tw-text-6">
                                    <i class="ph ph-currency-circle-dollar"></i>
                                </span>
                                Retrait
                            </a>
                        </li>

                        <li class="header-nav-submenu__item tw-mb-4 group-item group">
                            <a href="<%=new_retrait_path%>" class="header-nav-submenu__link fw-normal tw-text-lg text-dark-600 d-flex align-items-center tw-gap-2 bg-neutral-10 tw-px-3 tw-py-3 rounded-3 tw-duration-400 group-hover-bg-base-two-600 group-hover-text-white">
                                <span class="tw-text-6 group-hover-item-text-invert tw-duration-400">
                                    <%= image_tag 'icon/hand-icon1.png' %>
                                </span>
                                Demande de retrait
                            </a>
                        </li>
                        <li class="border-bottom-neutral-05 w-100 tw-mb-8 tw-mt-8"></li>

                        <li class="header-nav-submenu__item tw-mb-4">
                            <a href="<%=user_profile_path%>" class="header-nav-submenu__link fw-normal tw-text-lg text-dark-600 d-flex align-items-center tw-gap-2 hover-text-white bg-neutral-10 tw-px-3 tw-py-3 rounded-3 hover-bg-base-two-600 tw-duration-400">
                                <span class="tw-text-6">
                                    <i class="ph ph-user"></i>
                                </span>
                                Mon Profile
                            </a>
                        </li>
                        <% if user_signed_in? %>
                            <li class="header-nav-submenu__item">
                                <%= button_to logout_path, method: :delete, class: "header-nav-submenu__link fw-normal tw-text-lg text-dark-600 d-flex align-items-center tw-gap-2 hover-text-white bg-neutral-10 tw-px-3 tw-py-3 rounded-3 hover-bg-base-two-600 tw-duration-400", form_class: "d-inline" do %>
                                <span class="tw-text-6">
                                    <i class="ph ph-sign-out"></i>
                                </span>
                                Déconnexion
                                <% end %>
                            </li>
                        <% end %>
                    </ul>
                </div>
            </div>