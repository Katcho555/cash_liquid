                                    <button class="btn" title="Partager sur Facebook">
                                        <i class="fab fa-facebook-f"></i>
                                    </button>
                                    <button class="btn" title="Partager par email">
                                        <i class="fas fa-envelope"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div class="container py-4">
      <!-- Contenu -->

             <div class="flex-grow-1">

                <div class="bg-white shadow-sm rounded-4 p-2 mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold text-dark mb-0">
                            <i class="bi bi-people-fill text-primary me-2"></i>
                            Mon réseau
                        </h4>
                        <form class="d-flex" style="max-width: 400px;">
                            <input 
                            type="text" 
                            id="searchInput" 
                            class="form-control me-2 shadow-sm" 
                            placeholder="🔍 Rechercher un nom, email ou parrain..."
                            >
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless table-striped " id="usersTable">
                            <thead class="bg-primary text-white rounded-top">
                            <tr>
                                <th>Utilisateur</th>
                                <th>Email</th>
                                <th>Parrain</th>
                                <th>Statut</th>
                            </tr>
                            </thead>

                            <tbody>
                            <% @users.each do |user| %>
                                <% total_filleuls = user.filleuls.count %>
                                <% active_filleuls = user.filleuls.where(compte_status: true).count %>
                                <% total_recursifs = user.total_filleuls_recursifs %>

                                <% filleuls_directs = user.filleuls %>
                                <% filleuls_actifs = filleuls_directs.where(compte_status: true) %>


                                <tr class="border-bottom">
