  <script>
    document.addEventListener("turbo:load", function () {
      const toggleButton = document.querySelector(".dashboard-toggle-button");
      const closeButton = document.querySelector(".dashboard-close-button");
      const sidebar = document.querySelector(".dashboard-slidebar");

      if (!toggleButton || !closeButton || !sidebar) return;

      toggleButton.addEventListener("click", function () {
        sidebar.classList.toggle("active");
      });

      closeButton.addEventListener("click", function () {
        sidebar.classList.remove("active");
      });
    });
  </script>


