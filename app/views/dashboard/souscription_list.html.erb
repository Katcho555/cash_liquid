<!-- ===================== account my profile section start ====================== -->
<section class="bg-neutral-10 z-1">
    <div class="container">
        <div class="tw-pb-8 d-xl-flex tw-gap-6 w-100 tw-mt--193px">
            <%if current_user.admin?%>
                <%= render partial: "layouts/sidebar/admin" %>
            <%else%>
                <%= render partial: "layouts/sidebar/utilisateur" %>
            <%end%>  
            <!-- ========================= my profile account tabe section start ======================== -->
            <div class="flex-grow-1">

                <div class="bg-white tw-px-10 rounded-3 tw-py-8 w-100 tw-mb-6">
                    <button type="button" class="dashboard-toggle-button text-base-two-600 tw-text-8 tw-mb-6 d-xl-none d-block tw-m-l-end">
                        <i class="ph-bold ph-list"></i>
                    </button>
                     <%= render partial: "layouts/card_entete"%>
                </div>

                <div class="bg-white tw-px-8 tw-py-8 rounded-3 tw-mb-6">
                    <h4 class="fw-normal text-dark-600">Gestion des Souscriptions</h4>
                    <div>
                        <form action="#" class="">
                            <input type="text" id="searchInput" class="form-control mb-3 tw-px-3 tw-py-3 bg-neutral-10 rounded-3 border-0 max-w-500-px w-100 fw-normal tw-text-lg text-dark-600" placeholder="Rechercher un utilisateur, email, parrain...">
                        </form>
                    </div>
                </div>

                <div class="bg-white tw-px-8 tw-py-8 rounded-3">

                    <h5 class="fw-normal text-dark-600">Toutes les souscriptions</h5>
                    <span class="border-neutral-200 border-bottom tw-border-dashed w-100 tw-mt-6 tw-mb-6"></span>

                    <div class="table-responsive">
                         <table class="table table-striped table-hover table-bordered table-responsive" id="usersTable">
                            <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Utilisateur</th>
                                <th>Montant</th>
                                <th>Statut</th>
                                <th>Méthode de paiement</th>
                                <th>Référence</th>
                                <th>Date paiement</th>
                                <th>Créé le</th>
                                <th>Mis à jour le</th>
                            </tr>
                            </thead>
                            <tbody>
                            <% @subscriptions.each do |subscription| %>
                                <tr>
                                <td><%= subscription.id %></td>
                                <td>
                                    <% if subscription.user %>
                                    <%= subscription.user.prenom %> <%= subscription.user.nom %> (<%= subscription.user.email %>)
                                    <% else %>
                                    Utilisateur supprimé
                                    <% end %>
                                </td>
                                <td><%= number_to_currency(subscription.amount || 0, unit: "XOF", delimiter: " ", format: "%n %u") %></td>
                                <td>
                                    <% case subscription.status %>
                                    <% when "payé" %>
                                    <span class="badge bg-success">Payé</span>
                                    <% when "en_attente" %>
                                    <span class="badge bg-warning text-dark">En attente</span>
                                    <% else %>
                                    <span class="badge bg-secondary"><%= subscription.status %></span>
                                    <% end %>
                                </td>
                                <td><%= subscription.payment_method.presence || "—" %></td>
                                <td><%= subscription.reference.presence || "—" %></td>
                                <td><%= subscription.paid_at ? l(subscription.paid_at, format: :short) : "—" %></td>
                                <td><%= l(subscription.created_at, format: :short) %></td>
                                <td><%= l(subscription.updated_at, format: :short) %></td>
                                </tr>
                            <% end %>
                            </tbody>
                        </table>
                    </div>

                </div>

            </div>
<!-- ========================= my profile account tabe section end ======================== --> 

        </div>
    </div>
 </section>
<!-- ===================== account my profile section end ====================== -->

<!-- =========================== my profile footer section start ============================= -->
 <%= render partial: "layouts/footer" %>



<script>
  document.addEventListener("turbo:load", function() {
    const input = document.getElementById("searchInput");
    const table = document.getElementById("usersTable");
    input.addEventListener("keyup", function() {
      const filter = input.value.toLowerCase();
      const rows = table.getElementsByTagName("tr");

      for(let i = 1; i < rows.length; i++) { // Skip header row
        const row = rows[i];
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? "" : "none";
      }
    });
  });
</script>

