                                                    <div class="info-label">
                                                        <i class="fas fa-phone"></i> Téléphone
                                                    </div>
                                                    <div class="info-value">
                                                        <%= current_user.phone || "Non renseigné" %>
                                                    </div>
                                                </div>

                                                <div class="info-card">
                                                    <div class="info-label">
                                                        <i class="fas fa-briefcase"></i> Profession
                                                    </div>
                                                    <div class="info-value">
                                                        <%= current_user.profession || "Non renseignée" %>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Informations de localisation -->
                                            <div class="col-lg-6">
                                                <h4 class="section-title">Localisation</h4>
                                                
                                                <div class="info-card">
                                                    <div class="info-label">
                                                        <i class="fas fa-globe"></i> Pays
                                                    </div>
                                                    <div class="info-value">
                                                        <%= current_user.country || "Non renseigné" %>
                                                    </div>
                                                </div>

                                                <div class="info-card">
                                                    <div class="info-label">
                                                        <i class="fas fa-city"></i> Ville
                                                    </div>
                                                    <div class="info-value">
                                                        <%= current_user.city || "Non renseignée" %>
                                                    </div>
                                                </div>


                                                <div class="info-card">
                                                    <div class="info-label">
                                                        <i class="fas fa-calendar-alt"></i> Date d'inscription
                                                    </div>
                                                    <div class="info-value">
                                                        <%= current_user.created_at.strftime("%d/%m/%Y") %>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                    <!-- Onglet Modification -->
                                    <div class="tab-pane fade" id="edit" role="tabpanel">
                                        <%= form_for(current_user, url: profil_path, html: { method: :put, class: "row g-3" }) do |f| %>

                                            <% if current_user.errors.any? %>
                                                <div class="alert alert-danger">
                                                    <h5 class="alert-heading">Erreurs :</h5>
                                                    <ul class="mb-0">
                                                        <% current_user.errors.full_messages.each do |msg| %>
                                                            <li><%= msg %></li>
                                                        <% end %>
                                                    </ul>
                                                </div>
                                            <% end %>

                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Nom</label>
                                                <%= f.text_field :nom, class: "form-control-profile input-width" %>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Prénom</label>
                                                <%= f.text_field :prenom, class: "form-control-profile input-width" %>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Profession</label>
                                                <%= f.text_field :profession, class: "form-control-profile input-width" %>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Email</label>
                                                <%= f.email_field :email, class: "form-control-profile input-width" %>
                                            </div>

                                            <!-- Champ téléphone avec indicatif -->
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Téléphone</label>
                                                <div class="phone-input-group">
                                                    <select id="dialCodeEdit" class="dial-code-select">
                                                        <!-- Les options seront ajoutées dynamiquement -->
                                                    </select>
                                                    <%= f.text_field :phone, 
                                                        class: "form-control-profile phone-input", 
                                                        id: "phoneNumberEdit",
                                                        placeholder: "Numéro de téléphone" %>
                                                </div>
                                                <%= f.hidden_field :phone, id: "phoneFullEdit" %>
                                            </div>

                                            <!-- Champ pays avec sélecteur -->
                                            <div class="col-md-3">
                                                <label class="form-label fw-bold">Pays</label>
                                                <div class="country-select-wrapper input-width">
                                                    <%= f.select :country, [], {}, 
                                                        class: "form-control-profile w-100", 
                                                        id: "countrySelectEdit" %>
                                                    <i class="fas fa-chevron-down"></i>
                                                </div>
                                            </div>

                                            <div class="col-md-3">
                                                <label class="form-label fw-bold">Ville</label>
                                                <%= f.text_field :city, class: "form-control-profile w-100" %>
                                            </div>


                                            <div class="col-12">
                                                <hr class="my-4">
                                                <h5 class="mb-3 text-primary fw-bold">Changer le mot de passe</h5>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Nouveau mot de passe</label>
                                                <div class="password-toggle-group">
                                                    <%= f.password_field :password, 
                                                        class: "form-control-profile w-100", 
                                                        autocomplete: "new-password", 
                                                        placeholder: "Laisser vide si inchangé" %>
                                                    <button type="button" class="toggle-password" data-target="password">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Confirmation</label>
                                                <div class="password-toggle-group">
                                                    <%= f.password_field :password_confirmation, 
                                                        class: "form-control-profile w-100", 
                                                        placeholder: "Confirmer le nouveau mot de passe" %>
                                                    <button type="button" class="toggle-password" data-target="password_confirmation">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label fw-bold">Mot de passe actuel <span class="text-danger">*</span></label>
                                                <div class="password-toggle-group">
                                                    <%= f.password_field :current_password, 
                                                        class: "form-control-profile w-100", 
                                                        autocomplete: "current-password",
                                                        placeholder: "Obligatoire pour toute modification" %>
                                                    <button type="button" class="toggle-password" data-target="current_password">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </div>
                                                <small class="text-muted">Mot de passe actuel requis pour confirmer les modifications</small>
                                            </div>

                                            <div class="col-12">
                                                <div class="d-flex justify-content-between mt-4">
                                                    <button type="button" class="btn btn-outline-secondary" onclick="window.location.reload()">
                                                        <i class="fas fa-times me-2"></i>Annuler
                                                    </button>
                                                    <%= f.submit "Mettre à jour", class: "edit-btn px-4" %>
                                                </div>
                                            </div>
                                        <% end %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

    <%= render partial: "layouts/footer_admin"%>

  </div>
<%end%>

<script>
    // Fonction pour charger les données JSON des pays
    function loadCountries() {
        fetch('/assets/countries.json')
            .then(res => res.json())
            .then(countries => {
                const countrySelect = document.getElementById('countrySelectEdit');
                const dialCodeSelect = document.getElementById('dialCodeEdit');
                
                // Extraire le numéro de téléphone actuel
                const currentPhone = "<%= current_user.phone || '' %>";
                let currentCountry = "<%= current_user.country || 'Bénin' %>";
                let currentDialCode = "+229";
                
                // Nettoyer les sélecteurs
                countrySelect.innerHTML = '';
                dialCodeSelect.innerHTML = '';
                
                // Ajouter les options de pays
                countries.forEach(country => {
                    // Option pour le pays
                    const countryOption = document.createElement('option');
                    countryOption.value = country.name;
                    countryOption.textContent = `${country.flag} ${country.name}`;
                    countrySelect.appendChild(countryOption);
                    
                    // Option pour l'indicatif
                    const dialOption = document.createElement('option');
                    dialOption.value = country.dial_code;
                    dialOption.textContent = `${country.flag} ${country.dial_code}`;
                    dialOption.dataset.country = country.name;
                    dialCodeSelect.appendChild(dialOption);
                    
                    // Déterminer le pays et l'indicatif actuels
                    if (currentPhone.includes(country.dial_code)) {
                        currentDialCode = country.dial_code;
                        currentCountry = country.name;
                    }
                });
                
                // Définir les valeurs par défaut
                countrySelect.value = currentCountry;
                dialCodeSelect.value = currentDialCode;
                
                // Extraire le numéro sans l'indicatif
                let phoneNumber = currentPhone;
                if (currentDialCode && currentPhone.includes(currentDialCode)) {
                    phoneNumber = currentPhone.replace(currentDialCode, '').trim();
                }
                document.getElementById('phoneNumberEdit').value = phoneNumber;
                
                // Mettre à jour le champ caché avec la valeur complète
                updatePhoneFull();
                
                // Synchroniser les sélecteurs
                countrySelect.addEventListener('change', function() {
                    const selectedCountry = this.value;
                    const dialOption = dialCodeSelect.querySelector(`option[data-country="${selectedCountry}"]`);
                    if (dialOption) {
                        dialCodeSelect.value = dialOption.value;
                    }
                    updatePhoneFull();
                });
                
                dialCodeSelect.addEventListener('change', function() {
                    const selectedDial = this.value;
                    const countryOption = Array.from(dialCodeSelect.options)
                        .find(opt => opt.value === selectedDial);
                    if (countryOption && countryOption.dataset.country) {
                        countrySelect.value = countryOption.dataset.country;
                    }
                    updatePhoneFull();
                });
                
                // Mettre à jour le numéro complet quand le numéro change
                document.getElementById('phoneNumberEdit').addEventListener('input', updatePhoneFull);
            })
            .catch(err => {
                console.error('Erreur lors du chargement des pays:', err);
                // Fallback en cas d'erreur
                const countrySelect = document.getElementById('countrySelectEdit');
                const dialCodeSelect = document.getElementById('dialCodeEdit');
                
                const fallbackCountries = [
                    { name: "Bénin", flag: "🇧🇯", dial_code: "+229" },
                    { name: "France", flag: "🇫🇷", dial_code: "+33" },
                    { name: "Côte d'Ivoire", flag: "🇨🇮", dial_code: "+225" },
                    { name: "Sénégal", flag: "🇸🇳", dial_code: "+221" },
                    { name: "Canada", flag: "🇨🇦", dial_code: "+1" },
                    { name: "États-Unis", flag: "🇺🇸", dial_code: "+1" }
                ];
                
                fallbackCountries.forEach(country => {
                    const countryOption = document.createElement('option');
                    countryOption.value = country.name;
                    countryOption.textContent = `${country.flag} ${country.name}`;
                    countrySelect.appendChild(countryOption);
                    
                    const dialOption = document.createElement('option');
                    dialOption.value = country.dial_code;
                    dialOption.textContent = `${country.flag} ${country.dial_code}`;
                    dialOption.dataset.country = country.name;
                    dialCodeSelect.appendChild(dialOption);
                });
                
                countrySelect.value = "<%= current_user.country || 'Bénin' %>";
                dialCodeSelect.value = "+229";
            });
    }
    
    // Fonction pour mettre à jour le champ téléphone complet
    function updatePhoneFull() {
        const dialCode = document.getElementById('dialCodeEdit').value;
        const phoneNumber = document.getElementById('phoneNumberEdit').value;
        const phoneFull = document.getElementById('phoneFullEdit');
        
        if (phoneNumber) {
            phoneFull.value = `${dialCode}${phoneNumber}`;
        } else {
            phoneFull.value = '';
        }
    }
    
    // Initialiser les sélecteurs de pays au chargement de la page
    document.addEventListener('DOMContentLoaded', function() {
        loadCountries();
        
        // Activer les onglets
        const triggerTabList = [].slice.call(document.querySelectorAll('#profileTabs button'));
        triggerTabList.forEach(function (triggerEl) {
            const tabTrigger = new bootstrap.Tab(triggerEl);
            triggerEl.addEventListener('click', function (event) {
                event.preventDefault();
                tabTrigger.show();
            });
        });
        
        // Gestion de la visibilité des mots de passe
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function() {
                const target = this.getAttribute('data-target');
                const input = document.getElementById(`user_${target}`);
                const icon = this.querySelector('i');
                
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            });
        });
        
        // Gérer la soumission du formulaire
        document.querySelector('form').addEventListener('submit', function(e) {
            // Assurer que le numéro de téléphone complet est bien défini
            updatePhoneFull();
            
            // Valider la correspondance des mots de passe
            const password = document.getElementById('user_password');
            const confirmPassword = document.getElementById('user_password_confirmation');
            
            if (password.value && password.value !== confirmPassword.value) {
                e.preventDefault();
                alert('Les mots de passe ne correspondent pas.');
                confirmPassword.focus();
            }
        });
    });
</script>