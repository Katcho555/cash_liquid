                                    </td>

                                    <td>
                                        <% if user.compte_status %>
                                        <span class="badge bg-success bg-opacity-75">Actif</span>
                                        <% else %>
                                        <span class="badge bg-secondary bg-opacity-75">Inactif</span>
                                        <% end %>
                                    </td>
                                </tr>

                                <div class="modal fade" id="filleulsModal-<%= user.id %>" tabindex="-1">
                                    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                                        <div class="modal-content">

                                        <!-- HEADER -->
                                        <div class="modal-header bg-primary text-white">
                                            <div>
                                            <h5 class="modal-title mb-1">
                                                Filleuls directs
                                            </h5>
                                            <small>
                                                Parrain : <strong><%= user.nom_complet %></strong>
                                            </small>
                                            </div>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>

                                        <!-- STATS -->
                                        <div class="px-4 py-3 border-bottom bg-light d-flex justify-content-between">
                                            <div>
                                            <span class="fw-semibold">Total :</span>
