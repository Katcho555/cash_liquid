<!-- app/views/admin/spin_configurations/_wheel_preview.html.erb -->
<div class="position-relative d-inline-block">
  <div id="mini-wheel"
       style="width:180px; height:180px; border-radius:50%; background: conic-gradient(
         <%= SpinConfiguration.active.order(:id).map.with_index do |c,i|
              "##{ %w[FF6B6B 4ECDC4 45B7D1 96CEB4 FFEAA7 DDA0DD 98D8C8 F7DC6F BB8FCE 85C1E9 F8C471 82E0AA][i%12] } #{i*360/SpinConfiguration.active.count}deg #{(i+1)*360/SpinConfiguration.active.count}deg"
            end.join(', ') %>);
         box-shadow:0 4px 12px rgba(0,0,0,.15);">
  </div>
  <div style="position:absolute; top:-8px; left:50%; transform:translateX(-50%);
              width:0; height:0; border-left:10px solid transparent;
              border-right:10px solid transparent; border-bottom:14px solid #e63946;">
  </div>
</div>