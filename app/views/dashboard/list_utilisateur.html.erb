<!-- ===== DASHBOARD USER – COMPLET ===== -->
<div class="ux-dashboard">
  <!-- Sidebar -->
  

     <%if current_user.admin?%>
        <%= render partial: "layouts/sidebar/admin" %>
    <%else%>
        <%= render partial: "layouts/sidebar/utilisateur" %>
    <%end%>

    <!-- Main -->
        <main class="ux-main">

            <%= render partial: "layouts/card_entete"%>

            <!-- Contenu -->
            <div class="ux-content p-3 p-lg-4">
              <!-- Contenu -->
            <!-- ========================= my profile account tabe section start ======================== -->
            <div class="flex-grow-1">

                <div class="bg-white shadow-sm rounded-4 p-5 mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold text-dark mb-0">
                            <i class="bi bi-people-fill text-primary me-2"></i>
                            Gestion des Utilisateurs & Parrainages
                        </h4>
                        <form class="d-flex" style="max-width: 400px;">
                            <input 
                            type="text" 
                            id="searchInput" 
                            class="form-control me-2 shadow-sm" 
                            placeholder="🔍 Rechercher un nom, email ou parrain..."
                            >
                        </form>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle table-borderless" id="usersTable">
                            <thead class="bg-primary text-white rounded-top">
                            <tr>
                                <th>Utilisateur</th>
                                <th>Email</th>
                                <th>Parrain</th>
                                <th>Statut</th>
                                <th>Balance</th>
                                <th>Filleuls directs</th>
                                <th>Filleuls totaux</th>
                                <th>Détails</th>
                            </tr>
                            </thead>

                            <tbody>
                            <% @users.each do |user| %>
                                <% total_filleuls = user.filleuls.count %>
                                <% active_filleuls = user.filleuls.where(compte_status: true).count %>
                                <% total_recursifs = user.total_filleuls_recursifs %>

                                <tr class="border-bottom">
                                <td>
                                    <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width:40px; height:40px;">
                                        <%= user.prenom[0].upcase %>
                                    </div>
                                    <div>
                                        <strong class="text-dark">
                                        <%= link_to arbre_user_path(user), class: "text-dark", data: { turbo: false } do %>
                                                <%= user.nom_complet %>
                                            <% end %>

                                            </strong><br>
                                        <small class="text-muted">ID: <%= user.id %></small>
                                    </div>
                                    </div>
                                </td>

                                <td class="text-muted"><%= user.email %></td>

                                <td>
                                    <% if user.parrain %>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-person-check-fill text-success me-1"></i>
                                        <%= user.parrain.nom_complet %>
                                    </span>
                                    <% else %>
                                    <em class="text-secondary">Aucun</em>
                                    <% end %>
                                </td>

                                <td>
                                    <% if user.compte_status %>
                                    <span class="badge bg-success bg-opacity-75">Actif</span>
                                    <% else %>
                                    <span class="badge bg-secondary bg-opacity-75">Inactif</span>
                                    <% end %>
                                </td>

                                <td>
                                    <% if current_user.admin? %>
                                        <a href="#" 
                                        class="edit-balance" 
                                        data-user-id="<%= user.id %>" 
                                        data-balance="<%= user.balance || 0 %>">
                                        <%= number_to_currency(user.balance || 0, unit: "XOF", delimiter: " ", format: "%n %u") %>
                                        </a>
                                    <% else %>
                                        <%= number_to_currency(user.balance || 0, unit: "XOF", delimiter: " ", format: "%n %u") %>
                                    <% end %>
                                </td>

                            



                                <td><span class="fw-semibold text-primary"><%= active_filleuls %> / <%= total_filleuls %></span></td>
                                <td><span class="fw-semibold text-dark"><%= user.total_filleuls_recursifs %></span></td>


                                <td>
                                    <% if total_recursifs > 0 %>
                                    <button class="btn btn-outline-primary btn-sm" 
                                            type="button" 
                                            data-bs-toggle="collapse" 
                                            data-bs-target="#filleuls-<%= user.id %>">
                                        <i class="bi bi-diagram-3"></i> Voir
                                    </button>

                                    <div class="collapse mt-3" id="filleuls-<%= user.id %>">
                                        <div class="card card-body border-0 bg-light">
                                        <% user.filleuls.each do |f| %>
                                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                            <div>
                                                <strong><%= f.prenom %> <%= f.nom %></strong>
                                                <small class="text-muted d-block"><%= f.email %></small>
                                            </div>
                                            <div class="text-end">
                                                <% if f.compte_status %>
                                                <span class="badge bg-success">Actif</span>
                                                <% else %>
                                                <span class="badge bg-secondary">Inactif</span>
                                                <% end %>
                                                <div class="text-primary small mt-1">
                                                <%= number_to_currency(f.balance || 0, unit: "XOF", delimiter: " ", format: "%n %u") %>
                                                </div>
                                            </div>
                                            </div>
                                        <% end %>
                                        </div>
                                    </div>
                                    <% else %>
                                    <em class="text-muted">Aucun filleul</em>
                                    <% end %>
                                </td>
                                </tr>
                            <% end %>
                            </tbody>
                        </table>
                        <%if current_user.admin?%>
                            <div class="d-flex justify-content-center mt-3">
                                <%= paginate @users %>
                            </div>
                        <%end%>
                    </div>
                </div>
         
              <!--FIN  Contenu -->
            </div>
        </main>
    </div>

 <div class="modal fade" id="editBalanceModal" tabindex="-1" aria-labelledby="editBalanceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="editBalanceModalLabel">Modifier la balance</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form id="editBalanceForm">
            <input type="hidden" id="user_id" name="user_id">
            <div class="mb-3">
                <label for="balance" class="form-label">Nouvelle balance (XOF)</label>
                <input type="number" class="form-control" id="balance" name="balance" required>
            </div>
            <div class="mb-3">
                <label for="admin_password" class="form-label">Mot de passe administrateur</label>
                <input type="password" class="form-control" id="admin_password" name="admin_password" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">Confirmer</button>
            </form>
        </div>
        </div>
    </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const input = document.getElementById("searchInput");
    const table = document.getElementById("usersTable");
    input.addEventListener("keyup", function() {
      const filter = input.value.toLowerCase();
      const rows = table.getElementsByTagName("tr");

      for(let i = 1; i < rows.length; i++) { // Skip header row
        const row = rows[i];
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(filter) ? "" : "none";
      }
    });
  });
</script>

<script>
    document.addEventListener("turbo:load", () => {
        const modal = new bootstrap.Modal(document.getElementById('editBalanceModal'));
        const form = document.getElementById('editBalanceForm');

        document.querySelectorAll(".edit-balance").forEach(link => {
            link.addEventListener("click", (e) => {
            e.preventDefault();
            document.getElementById('user_id').value = link.dataset.userId;
            document.getElementById('balance').value = link.dataset.balance;
            document.getElementById('admin_password').value = "";
            modal.show();
            });
        });

        form.addEventListener("submit", (e) => {
            e.preventDefault();
            const userId = document.getElementById('user_id').value;
            const balance = document.getElementById('balance').value;
            const adminPassword = document.getElementById('admin_password').value;

            fetch(`/dashboard/update_balance/${userId}`, {
            method: "PATCH",
            headers: {
                "Content-Type": "application/json",
                "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
            },
            body: JSON.stringify({ balance: balance, admin_password: adminPassword })
            })
            .then(res => res.json())
            .then(data => {
            if (data.success) {
                // Met à jour la valeur directement dans le tableau
                const cell = document.querySelector(`a.edit-balance[data-user-id='${userId}']`);
                cell.textContent = `${Number(balance).toLocaleString()} XOF`;
                cell.dataset.balance = balance;
                modal.hide();
                alert("✅ Balance mise à jour avec succès !");
            } else {
                alert("❌ " + (data.message || "Erreur lors de la mise à jour."));
            }
            })
            .catch(() => alert("Erreur réseau."));
        });
    });
</script>